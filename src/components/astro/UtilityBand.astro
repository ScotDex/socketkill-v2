---
import EntityLookup from '../svelte/EntityLookup.svelte'
---

<div class="relative z-50 w-full bg-black border-b border-[var(--color-border-dim)]">
    <div class="max-w-[1700px] mx-auto px-4 py-1 flex items-center gap-4
                font-mono text-[0.75rem] uppercase tracking-widest text-white/40">
        <nav class="flex items-center gap-4" aria-label="Site navigation">
            <a href="/about" class="band-link">About</a>
            <a href="/stats" class="band-link">Top 10</a>
            <a href="/obs" class="band-link">OBS</a>
            <a href="https://socketkill.com/local/"
               target="_blank" rel="noopener noreferrer" class="band-link">Local</a>
            <a href="https://www.twitch.tv/scottish_dex"
               target="_blank" rel="noopener noreferrer" class="band-link">Radio Eve</a>
        <details class="band-drop">
                <summary class="band-link">FRIENDS</summary>
                <div class="band-menu">
                    <a href="https://eveworkbench.com" target="_blank" rel="noopener noreferrer" class="band-menu-link">EVE_WORKBENCH</a>
                    <a href="https://zkillboard.com/" target="_blank" rel="noopener noreferrer" class="band-menu-link">ZKILLBOARD</a>
                    <a href="https://wiki.eveuniversity.org/Main_Page" target="_blank" rel="noopener noreferrer" class="band-menu-link">EVE_UNI</a>
                    <a href="https://eve-kill.com/" target="_blank" rel="noopener noreferrer" class="band-menu-link">EVE_KILL</a>
                    <a href="https://www.reddit.com/user/blackriseregion/" target="_blank" rel="noopener noreferrer" class="band-menu-link">BLACKRISE_NEWS</a>
                    <a href="https://killmail.app/" target="_blank" rel="noopener noreferrer" class="band-menu-link">KILLMAIL.APP</a>
                    <a href="https://www.rustybot.co.uk/" target="_blank" rel="noopener noreferrer" class="band-menu-link">RUSTY_BOT</a>

                </div>
            </details>
        </nav>
        <div class="ml-auto flex items-center gap-3">
        <EntityLookup client:load />
        </div>
    </div>
</div>

<style>
    .band-link {
        color: rgba(255, 255, 255, 0.4);
        text-decoration: none;
        transition: color 0.2s;
    }
    .band-link:hover {
        color: var(--color-neon-green);
        text-shadow: 0 0 5px rgba(63, 185, 80, 0.5);
    }

    .band-drop {
        position: relative;
    }
    .band-drop summary {
        list-style: none;
        cursor: pointer;
    }
    .band-drop summary::-webkit-details-marker {
        display: none;
    }
    .band-menu {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        min-width: 160px;
        padding: 6px 0;
        background: rgba(10, 12, 16, 0.98);
        border: 1px solid var(--color-border-mid);
        z-index: 100;
    }
    .band-menu-link {
        display: block;
        padding: 4px 12px;
        font-size: 0.75rem;
        letter-spacing: 1px;
        text-decoration: none;
        color: rgba(63, 185, 80, 0.6);
    }
    .band-menu-link:hover {
        color: var(--color-neon-green);
    }
</style>