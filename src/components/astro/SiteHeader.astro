---
import TitleBoot from '../svelte/TitleBoot.svelte'
---

<header class="flex items-center justify-between border-b border-white/10 pb-3 mb-4">
    <div class="min-w-0">
        <TitleBoot client:load />
    </div>

    <div class="flex items-center gap-2 text-xs uppercase tracking-widest opacity-40 whitespace-nowrap">
        <span>KILLMAILS PROCESSED</span>
        <span id="kill-counter" class="text-white font-bold text-sm">0</span>
        <span>//</span>
        <span>TQ_STATUS</span>
        <span id="player-count" class="text-white font-bold text-sm">0</span>
        <span>//</span>
        <span>ISK_DESTROYED</span>
        <span id="isk-ticker" class="text-white font-bold text-sm">0.00T</span>
    </div>

    <div>
        <div id="status" class="text-red-400">● CONNECTING...</div>
    </div>
</header>