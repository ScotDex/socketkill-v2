---
import { externalLink } from '../../lib/entity-links.js'
const { a, topDamage = false } = Astro.props
const isNpc = !a.characterID
const corpKnown = a.corporationID && a.corp && a.corp !== 'Unknown'
---
<li class:list={["atk relative flex items-start gap-2.5 text-sm overflow-hidden py-1.5", { "atk-fb": a.finalBlow }]}>
    <span class="dmg" style={`width:${a.damagePercent}%`}></span>

    {(a.finalBlow || topDamage) && (
        <span class="status-gutter relative flex-shrink-0">
            {a.finalBlow && <span class="badge fb-badge">FINAL BLOW</span>}
            {topDamage && <span class="badge td-badge">TOP DMG</span>}
        </span>
    )}

    <div class="relative w-12 h-12 flex-shrink-0 bg-black/40">
        {!isNpc && <img src={`https://images.evetech.net/characters/${a.characterID}/portrait?size=64`} class="w-full h-full" alt="" loading="lazy" />}
    </div>

    <div class="relative flex-1 min-w-0 flex flex-col gap-0.5">
        <div class="ui truncate text-white text-sm">
            {isNpc
                ? <span title={a.ship}>{a.name !== 'Unknown' ? a.name : a.ship}</span>
                : <a href={externalLink('character', a.characterID)} target="_blank" rel="noopener noreferrer" class="link">{a.name}</a>}
        </div>

        {a.ship && (
            <div class="ui flex items-center gap-1.5 min-w-0 text-[var(--color-text-faint)] text-xs">
                {a.shipTypeID && <img src={`https://images.evetech.net/types/${a.shipTypeID}/icon?size=32`} class="w-4 h-4 flex-shrink-0" alt="" title={a.ship} loading="lazy" />}
                {a.weaponTypeID && a.weaponTypeID !== a.shipTypeID && <img src={`https://images.evetech.net/types/${a.weaponTypeID}/icon?size=32`} class="w-4 h-4 flex-shrink-0" alt="" title={a.weapon} loading="lazy" />}
                <span class="truncate">{a.ship}</span>
            </div>
        )}

        {corpKnown && (
            <div class="ui truncate text-[var(--color-text-faint)] text-xs">
                <a href={externalLink('corp', a.corporationID)} target="_blank" rel="noopener noreferrer" class="link">{a.corp}</a>
            </div>
        )}
        {a.allianceID && a.alliance && (
            <div class="ui truncate text-[var(--color-text-faint)] text-xs">
                <a href={externalLink('alliance', a.allianceID)} target="_blank" rel="noopener noreferrer" class="link">{a.alliance}</a>
            </div>
        )}
    </div>

    <div class="relative font-mono text-xs tabular-nums text-right flex-shrink-0">
        {Number.isFinite(a.damage) && <div class="text-white">{a.damage.toLocaleString()}</div>}
        <div class="text-[var(--color-text-faint)]">{a.damagePercent}%</div>
    </div>
</li>

<style>
    .dmg {
        position: absolute; top: 0; bottom: 0; left: 0;
        background: color-mix(in srgb, var(--color-isk-billion) 8%, transparent);
        animation: grow 0.5s ease-out 0.25s both;
        transform-origin: left;
    }
    @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }

    .status-gutter {
        display: flex; flex-direction: column;
        justify-content: center; gap: 3px;
        width: 38px; align-self: stretch;
    }
    .badge {
        font-family: var(--font-body);
        font-size: 8px; font-weight: 700;
        line-height: 1.15; letter-spacing: 0.08em;
        text-transform: uppercase; text-align: center;
    }
    .fb-badge {
        color: var(--color-isk-billion);
        text-shadow: 0 0 8px color-mix(in srgb, var(--color-isk-billion) 50%, transparent);
    }
    .td-badge {
        color: var(--color-whale-accent);
        text-shadow: 0 0 8px color-mix(in srgb, var(--color-whale-accent) 45%, transparent);
    }

    .link { transition: color 0.15s, text-shadow 0.15s; }
    .link:hover { color: var(--color-neon-green); text-shadow: var(--shadow-phosphor); }
    .ui { font-family: var(--font-body); }

    .atk-fb {
        background: color-mix(in srgb, var(--color-isk-billion) 6%, transparent);
        border-left: 2px solid var(--color-isk-billion);
        padding-left: 6px;
    }

    @media (prefers-reduced-motion: reduce) { .dmg { animation: none; } }
</style>