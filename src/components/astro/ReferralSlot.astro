---
interface Slide {
    img: string   
    href: string  
    alt: string   
    kind: 'referral' | 'sponsor'  
}

const slides: Slide[] = [
    {
        img: 'https://edge.socketkill.com/friendimage.jpeg',
        href: 'https://www.eveonline.com/signup?invc=e32ca441-aa95-4eb7-ad06-d2c6334a5872',
        alt: 'Start playing EVE Online with a bonus 1 million skill points',
        kind: 'referral',
    },
    {
        img: 'https://edge.socketkill.com/PartnerBadge2.png',
        href: 'https://www.eveonline.com/partners',
        alt: 'Socket.Kill is an Eve Partner Site',
        kind: 'referral',
    },
    {
        img: 'https://edge.socketkill.com/NoD_Stacked_White.png',
        href: 'https://www.eveonline.com/partners',
        alt: 'Nerd or Die Advertising',
        kind: 'referral',
    },
]

const { interval = 8000 } = Astro.props
---

<aside class="ref-slot" aria-label="Referrals and sponsors" data-rotator data-interval={interval}>
    <div class="ref-head">
        <span></span>
        <span class="ref-kind" data-kind-label>{slides[0].kind}</span>
    </div>

    <div class="ref-stage">
        {slides.map((s, i) => (
            <a
                href={s.href}
                target="_blank"
                rel="sponsored noopener"
                class="ref-item"
                data-slide
                data-kind={s.kind}
                data-active={i === 0 ? 'true' : 'false'}
                aria-hidden={i === 0 ? 'false' : 'true'}
                tabindex={i === 0 ? 0 : -1}
            >
                <img
                    src={s.img}
                    alt={s.alt}
                    width="300"
                    height="250"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                />
            </a>
        ))}
    </div>

    {slides.length > 1 && (
        <div class="ref-dots" role="group" aria-label="Choose slide">
            {slides.map((_, i) => (
                <button type="button" data-dot aria-label={`Show slide ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} />
            ))}
        </div>
    )}

    <p class="ref-foot">
        Referral links cover server costs. <a href="#advertise">Rent this slot for ISK</a>
    </p>
</aside>

<script>
    function initRotators() {
        document.querySelectorAll<HTMLElement>('[data-rotator]').forEach((root) => {
            const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')]
            const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')]
            const kindLabel = root.querySelector<HTMLElement>('[data-kind-label]')
            if (slides.length < 2) return

            const delay = Number(root.dataset.interval) || 8000
            const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
            let current = 0
            let timer: ReturnType<typeof setInterval> | undefined

            const show = (n: number) => {
                current = (n + slides.length) % slides.length
                slides.forEach((s, k) => {
                    const on = k === current
                    s.dataset.active = String(on)
                    s.setAttribute('aria-hidden', String(!on))
                    s.tabIndex = on ? 0 : -1
                })
                dots.forEach((d, k) => d.setAttribute('aria-current', String(k === current)))
                if (kindLabel) kindLabel.textContent = slides[current].dataset.kind ?? ''
            }

            const stop = () => clearInterval(timer)
            const start = () => {
                stop()
                if (!reduceMotion) timer = setInterval(() => show(current + 1), delay)
            }

            root.addEventListener('mouseenter', stop)
            root.addEventListener('mouseleave', start)
            root.addEventListener('focusin', stop)
            root.addEventListener('focusout', start)
            dots.forEach((d, k) => d.addEventListener('click', () => show(k)))
            document.addEventListener('astro:before-swap', stop, { once: true })

            // Random start: every paid slot gets a fair share of first impressions.
            show(Math.floor(Math.random() * slides.length))
            start()
        })
    }

    document.addEventListener('astro:page-load', initRotators)
</script>

<style>
    .ref-slot {
        border: 1px solid var(--color-border-dim);
        background: rgb(13 15 19 / 0.85);
        font-family: var(--font-mono);
    }

    .ref-head {
        display: flex;
        justify-content: space-between;
        padding: 0.45rem 0.7rem;
        border-bottom: 1px solid var(--color-border-dim);
        font-size: 0.62rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-text-faint);
    }

    .ref-kind { color: var(--color-neon-green); }

    .ref-stage {
        display: grid;
        aspect-ratio: 300 / 250;
        background: var(--color-dark-bg);
    }

    .ref-item {
        grid-area: 1 / 1;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.8s ease-in-out;
    }

    .ref-item[data-active='true'] {
        opacity: 1;
        pointer-events: auto;
    }

    .ref-item img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .ref-item:focus-visible {
        outline: 1px solid var(--color-neon-green);
        outline-offset: -3px;
    }

    .ref-dots {
        display: flex;
        justify-content: center;
        gap: 6px;
        padding: 0.5rem 0 0.2rem;
    }

    .ref-dots button {
        width: 18px;
        height: 3px;
        padding: 0;
        border: 0;
        background: var(--color-border-mid);
        cursor: pointer;
    }

    .ref-dots button[aria-current='true'] { background: var(--color-neon-green); }

    .ref-foot {
        margin: 0;
        padding: 0.4rem 0.7rem 0.6rem;
        font-size: 0.6rem;
        line-height: 1.5;
        color: var(--color-text-faint);
    }

    .ref-foot a { color: var(--color-neon-green); }

    @media (prefers-reduced-motion: reduce) {
        .ref-item { transition: none; }
    }
</style>