---
// src/components/astro/SiteFooter.astro
// Hybrid Icon/Text Single-Axis HUD
---

<footer class="w-full border-t border-gray-800/60 bg-black/95 text-gray-400 font-['Share_Tech_Mono'] z-50">
    <div class="max-w-[1920px] mx-auto px-4 py-2 flex flex-col md:flex-row items-center justify-between gap-4 text-xs md:text-sm">
        
        <div class="flex items-center gap-3">
            <span class="text-gray-500 uppercase tracking-widest text-[10px] md:text-xs">GLOBAL_NPC_DEATHS</span>
            <span id="npc-count" class="text-green-400 font-bold tracking-wider font-['Exo_2']" aria-live="polite">...</span>
        </div>

        <nav class="flex items-center gap-6" aria-label="Footer navigation">
            <a href="/about" class="text-gray-400 hover:text-white transition-colors duration-200" aria-label="About">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            </a>
            
            <details class="relative group cursor-pointer">
                <summary class="text-gray-400 hover:text-white transition-colors duration-200 list-none outline-none" aria-label="Network Links">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                </summary>
                
                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-48 bg-gray-900 border border-gray-700/50 rounded shadow-2xl p-2 flex flex-col gap-1 z-50 text-[11px] uppercase tracking-widest">
                    <a href="https://eveworkbench.com" target="_blank" rel="noopener" class="px-3 py-2 hover:bg-gray-800 hover:text-white rounded transition-colors">Eve_Workbench</a>
                    <a href="https://killmail.app/" target="_blank" rel="noopener" class="px-3 py-2 hover:bg-gray-800 hover:text-white rounded transition-colors">Killmail.app</a>
                    <a href="https://zkillboard.com/" target="_blank" rel="noopener" class="px-3 py-2 hover:bg-gray-800 hover:text-white rounded transition-colors">zKillboard</a>
                    <a href="https://everookies.com/" target="_blank" rel="noopener" class="px-3 py-2 hover:bg-gray-800 hover:text-white rounded transition-colors">Eve_Rookies</a>
                    <a href="https://wiki.eveuniversity.org/Main_Page" target="_blank" rel="noopener" class="px-3 py-2 hover:bg-gray-800 hover:text-white rounded transition-colors">Eve_Uni</a>
                    <a href="https://eve-kill.com/" target="_blank" rel="noopener" class="px-3 py-2 hover:bg-gray-800 hover:text-white rounded transition-colors">Eve_Kill</a>
                </div>
            </details>

            <a href="https://www.eveonline.com/news/view/eve-fanfest-wrapped" target="_blank" rel="noopener" class="text-yellow-500/80 hover:text-yellow-400 transition-colors duration-200" title="Fanfest 2026 Developer of the Year">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
            </a>
        </nav>

        <div class="flex items-center gap-3 text-[11px] text-gray-500">
            <a href="https://eve-kill.com/character/95282689" target="_blank" rel="noopener" class="hover:text-white transition-colors uppercase tracking-widest">Dexomus_Viliana</a>
            <span class="px-2 py-0.5 bg-gray-800/50 rounded text-gray-400">v2.0</span>
        </div>
    </div>

    <div class="w-full bg-[#050505] px-4 py-1.5 flex flex-wrap items-center justify-center gap-x-6 gap-y-1 text-[9px] text-gray-600/60 hover:text-gray-400 transition-colors font-['Exo_2']">
        <span>EVE Online and the EVE logo are the registered trademarks of Fenris Creations. All rights reserved.</span>
        <span class="flex items-center gap-2">
            [ DATA: <a href="https://developers.eveonline.com/api-explorer" target="_blank" rel="noopener" class="hover:text-white">ESI</a> / 
            <a href="https://github.com/zKillboard/zKillboard/wiki/API-(R2Z2)" target="_blank" rel="noopener" class="hover:text-white" title="R2 GitHub">R2</a> ]
            [ IMG: <a href="https://www.flickr.com/photos/rixxjavix/" target="_blank" rel="noopener" class="hover:text-white" title="RixxJavix Flickr">@RixxJavix</a> ]
        </span>
    </div>
</footer>

<script>
    const npcDisplay = document.getElementById('npc-count');

    async function updateNPCTicker() {
        if (!npcDisplay) return;

        try {
            const response = await fetch('https://api.socketkill.com/stats/npc-kills');
            if (!response.ok) throw new Error('API Status Non-200');
            
            const data = await response.json();
            
            if (data?.lifetimeTotal) {
                npcDisplay.innerText = data.lifetimeTotal.toLocaleString();
                npcDisplay.classList.add('opacity-50');
                setTimeout(() => npcDisplay.classList.remove('opacity-50'), 200);
            }
        } catch {
            npcDisplay.innerText = 'ERR_OFFLINE';
            npcDisplay.classList.add('text-red-500');
            npcDisplay.classList.remove('text-green-400');
        }
    }

    updateNPCTicker();
    setInterval(updateNPCTicker, 300_000);
</script>