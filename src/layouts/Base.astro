---
import '../styles/global.css'
const {
    title,
    ogTitle = "Socket.Kill",
    ogDescription = "Socket.Kill - Live kill feed for Eve Online optimized for rendering speed and performance, features include stream filter and analytics of the past 24h",
    ogImage = "https://socketkill.com/socket-preview-v2.png",
    ogImageWidth = "819",
    ogImageHeight = "1152",
    ogType = "website",
    twitterCard = "summary_large_image",
} = Astro.props


const canonicalURL = new URL(Astro.url.pathname, astro.site)
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Socket.Kill",
    url: "https://socketkill.com"
    description: ogDescription,
    applicationCategory: "GameApplication",
    operatingSystem: "Web"
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    about: { "@type": "VideoGame", name: "EVE Online" }
}
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="dark" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Exo+2:wght@300;400;600;700&display=swap" />
        <title>{title}</title>
        <meta name="description" content={ogDescription} />
        <link rel="canonical" href={canonicalURL} />
        <meta name="author" content="Dexomus Viliana" />
        <link rel="icon" type="image/png" href="https://edge.socketkill.com/favicon.png" />
        <link rel="apple-touch-icon" href="https://edge.socketkill.com/favicon.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content={ogImageWidth} />
        <meta property="og:image:height" content={ogImageHeight} />
        <meta property="og:site_name" content="Socketkill.com" />

        <meta name="twitter:card" content={twitterCard} />
        <meta name="twitter:title" content={ogTitle} />
        <meta name="twitter:description" content={ogDescription} />
        <meta name="twitter:image" content={ogImage} />

        <meta name="theme-color" content="#0a0b0e" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:image:alt" content="Socket.Kill live kill feed preview" />

        {noindex && <meta name="robots" content="noindex, nofollow" />}

        <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "9a7b8334fd974f46a3b570cbc18d90b1"}'></script>
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        <slot name="head"/>
    </head>
    <body>
        <slot />
    </body>
</html>