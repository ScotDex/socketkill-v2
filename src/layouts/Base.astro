---
import '../styles/global.css'
import UtilityBand from '../components/astro/UtilityBand.astro'
const ogBust = Math.random().toString(36).slice(2, 8)
const {
    title,
    ogTitle = "Socket.Kill",
    ogDescription = "Live kill stream for EVE Online.",
    keywords = "eve online, killboard, eve kills, killmail, new eden, eve online pvp, socketkill, socket, kill, socketkill.com, mmorpg",
    ogImage = `https://ws.socketkill.com/og/page/home?v=${ogBust}`,
    ogImageWidth="1200",
    ogImageHeight="630",
    ogType = "website",
    twitterCard="summary_large_image"
} = Astro.props

import { ClientRouter } from 'astro:transitions'


const canonicalURL = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site)
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Socket.Kill",
    url: "https://socketkill.com",
    description: ogDescription,
    applicationCategory: "GameApplication",
}
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="dark" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Exo+2:wght@300;400;600;700&display=swap" />
        <title>{title}</title>
        <meta name="description" content={ogDescription} />
        <meta name="keywords" content={keywords} />
        <link rel="canonical" href={canonicalURL} />
        <meta name="author" content="Dexomus Viliana" />
        <link rel="icon" type="image/png" href="https://edge.socketkill.com/favicon.png" />
        <link rel="apple-touch-icon" href="https://edge.socketkill.com/favicon.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content={ogImageWidth} />
        <meta property="og:image:height" content={ogImageHeight} />
        <meta property="og:site_name" content="Socketkill.com" />

        <meta name="twitter:card" content={twitterCard} />
        <meta name="twitter:title" content={ogTitle} />
        <meta name="twitter:description" content={ogDescription} />
        <meta name="twitter:image" content={ogImage} />

        <meta name="theme-color" content="#0a0b0e" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:image:alt" content="Socket.Kill live kill feed preview" />
        {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
        <slot name="head"/>
        <ClientRouter />
    </head>
    <body>
        <UtilityBand />
        <slot />
        <div class="partner-mark">
    <a href="https://www.eveonline.com/partners" target="_blank" rel="noopener noreferrer">
        <img src="https://edge.socketkill.com/PartnerBadge2.png" alt="EVE Online Partner" loading="lazy" />
    </a>
</div>
    </body>
</html>