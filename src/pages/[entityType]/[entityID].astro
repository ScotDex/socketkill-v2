---
import Base from '../../layouts/Base.astro'
import { externalLink, internalLink } from '../../lib/entity-links.js'
import { formatIsk } from '../../lib/filter-logic.js'
import '../kill/style.css'
import './style.css'


const ENTITY = {
    pilot: {
        label: 'PILOT',
        esiPath: id => `https://esi.evetech.net/latest/characters/${id}/`,
        image: id => `https://images.evetech.net/characters/${id}/portrait?size=256`,
        zkillType: 'character',
        evewhoPath: 'character',
        lossWord: 'LOSS',
    },
    corp: {
        label: 'CORPORATION',
        esiPath: id => `https://esi.evetech.net/latest/corporations/${id}/`,
        image: id => `https://images.evetech.net/corporations/${id}/logo?size=256`,
        zkillType: 'corp',
        evewhoPath: 'corporation',
        lossWord: 'LOSS',
    },
    alliance: {
        label: 'ALLIANCE',
        esiPath: id => `https://esi.evetech.net/latest/alliances/${id}/`,
        image: id => `https://images.evetech.net/alliances/${id}/logo?size=256`,
        zkillType: 'alliance',
        evewhoPath: 'alliance',
        lossWord: 'LOSS',
    },
}

const { entityType, entityID } = Astro.params
const conf = ENTITY[entityType]
const id = parseInt(entityID)
if (!conf || !/^\d+$/.test(entityID ?? '') || !Number.isFinite(id) || id <= 0) {
    return new Response('Not found', { status: 404 })
}
let identity = null
try {
    const res = await fetch(conf.esiPath(id))
    if (!res.ok) return new Response('Entity not found', { status: 404 })
    const data = await res.json()

    identity = {
        name: data.name,
        ticker: data.ticker ?? null,
        corpID: entityType === 'pilot' ? (data.corporation_id ?? null) : null,
        allianceID: entityType !== 'alliance' ? (data.alliance_id ?? null) : null,
        corpName: null,
        allianceName: null,
        // pilot -> birthday | corp/alliance -> date_founded
        founded: data.birthday ?? data.date_founded ?? null,
        securityStatus: data.security_status ?? null,  // pilot only
        memberCount: data.member_count ?? null,        // corp only
        warEligible: data.war_eligible ?? null,        // corp only
        ceoID: data.ceo_id ?? null,                    // corp only
        ceoName: null,
    }

    if (identity.corpID) {
        const r = await fetch(`https://esi.evetech.net/latest/corporations/${identity.corpID}/`)
        if (r.ok) identity.corpName = (await r.json()).name
    }
    if (identity.allianceID) {
        const r = await fetch(`https://esi.evetech.net/latest/alliances/${identity.allianceID}/`)
        if (r.ok) identity.allianceName = (await r.json()).name
    }
    if (identity.ceoID) {
        const r = await fetch(`https://esi.evetech.net/latest/characters/${identity.ceoID}/`)
        if (r.ok) identity.ceoName = (await r.json()).name
    }
} catch {
    return new Response('Entity lookup failed', { status: 502 })
}

let events = []
let windowDays = 30
let feedOnline = false
try {
    const res = await fetch(`https://ws.socketkill.com/api/entity/${entityType}/${id}`, {
        headers: { 'User-Agent': Astro.request.headers.get('user-agent') || 'SocketKill-Frontend/1.0' }
    })
    if (res.ok) {
        const data = await res.json()
        events = data.events ?? []
        windowDays = data.windowDays ?? 30
        feedOnline = true
    }
} catch { /* endpoint unreachable — offline state below */ }

Astro.response.headers.set('Cache-Control', 'public, max-age=60')

const kills = events.filter(e => !e.isLoss)
const losses = events.filter(e => e.isLoss)

function relativeTime(iso) {
    const diff = Date.now() - new Date(iso).getTime()
    const m = Math.floor(diff / 60000)
    if (m < 1) return 'JUST NOW'
    if (m < 60) return `${m}M AGO`
    const h = Math.floor(m / 60)
    if (h < 24) return `${h}H AGO`
    return `${Math.floor(h / 24)}D AGO`
}

function secColor(s) {
    if (s == null) return 'var(--color-text-faint)'
    if (s <= -5) return 'var(--color-isk-billion)'
    if (s < 0) return 'var(--color-whale-accent)'
    return 'var(--color-neon-green)'
}

function ageOf(iso) {
    if (!iso) return '—'
    const y = (Date.now() - new Date(iso).getTime()) / (365.25 * 864e5)
    return y < 1 ? `${Math.max(1, Math.round(y * 12))} MO` : `${Math.floor(y)} YRS`
}

function mostLost(list) {
    if (!list.length) return null
    const counts = {}
    for (const e of list) {
        counts[e.shipTypeID] ??= { n: 0, name: e.shipName }
        counts[e.shipTypeID].n++
    }
    const [typeID, d] = Object.entries(counts).sort((a, b) => b[1].n - a[1].n)[0]
    return { typeID, name: d.name, n: d.n }
}

function operatingArea(list) {
    const sys = {}, sp = {}
    for (const e of list) {
        sys[e.systemName] ??= { n: 0, region: e.regionName, space: e.space }
        sys[e.systemName].n++
        sp[e.space] = (sp[e.space] ?? 0) + 1
    }
    return {
        systems: Object.entries(sys).map(([name, d]) => ({ name, ...d }))
            .sort((a, b) => b.n - a.n).slice(0, 5),
        spaces: Object.entries(sp).map(([k, n]) => ({ k, n }))
            .sort((a, b) => b.n - a.n),
        total: list.length,
    }
}

const SPACE_CHIP = {
    high:    { label: 'HS',   color: 'var(--color-neon-green)' },
    low:     { label: 'LS',   color: 'var(--color-whale-accent)' },
    null:    { label: 'NULL', color: 'var(--color-isk-billion)' },
    wh:      { label: 'WH',   color: 'var(--color-terminal-blue)' },
    pochven: { label: 'PCH',  color: '#b07ce8' },
}

function valueColor(v) {
    if (v >= 10_000_000_000) return 'var(--color-whale-accent)'
    if (v >= 1_000_000_000) return 'var(--color-isk-billion)'
    return 'var(--color-neon-green)'
}
const lostHull = mostLost(losses)
const area = operatingArea(events)
const killPct = events.length ? (kills.length / events.length * 100) : 0
const cardAccent = entityType === 'pilot'
    ? secColor(identity.securityStatus)
    : 'var(--color-neon-green)'


const canonicalUrl = `https://socketkill.com/${entityType}/${id}`
const displayName = identity.ticker ? `${identity.name} [${identity.ticker}]` : identity.name
const title = `${identity.name} — ${conf.label.charAt(0) + conf.label.slice(1).toLowerCase()} Activity`

const KILLS_BG_COUNT = 24
const entityBg = `https://edge.socketkill.com/kills/kills-${String((id % KILLS_BG_COUNT) + 1).padStart(3, '0')}.webp`

---

<Base title={`${title} | Socketkill.com`} ogTitle={title}
    ogDescription={`Recent kills and losses for ${identity.name} — last ${windowDays} days, live from SocketKill.`}>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Share+Tech+Mono&display=swap" rel="stylesheet">

<div class="kill-screen art-bg" style={`--art-bg-url: url(${entityBg})`}>

    <!-- PAGE TITLE — <div>, not <header>: the global stylesheet hides
         bare `header` under 1023px, which would blank this on mobile. -->
    <div class="max-w-7xl mx-auto px-4 pt-6 relative z-10">
        <h1 class="kill-headline">{displayName}</h1>
        <p class="kill-sub">{conf.label} &nbsp;|&nbsp; LIVE ACTIVITY — LAST {windowDays} DAYS</p>
    </div>

    <main class="grid grid-cols-1 md:grid-cols-[360px_1fr] gap-4 p-4 max-w-7xl mx-auto relative z-10">
        <section class="flex flex-col gap-4">
            <div class="card" style={`--card-c: ${cardAccent}; --d: 0ms`}>
                <div class="card-h flex justify-between items-center">
                    <span>{conf.label.toLowerCase()} dossier</span>
                    <span class="tag">BETA</span>
                </div>

                {lostHull && (
                    <figure class="cover" style="margin:0">
                        <img src={`https://images.evetech.net/types/${lostHull.typeID}/render?size=512`}
                             alt={lostHull.name} loading="lazy" />
                    </figure>
                )}

                <div class={lostHull ? 'ident' : 'ident no-cover'}>
                    <img class="portrait-sm" src={conf.image(id)} alt={identity.name} loading="eager" />
                    <div class="who">
                        <div class="nm truncate">{identity.name}</div>
                        <div class="af">
                            {identity.corpID
                                ? <a href={internalLink('corp', identity.corpID)} class="link">{identity.corpName ?? '—'}</a>
                                : (identity.ticker ? `[${identity.ticker}]` : '')}
                        </div>
                        <div class="af">
                            {identity.allianceID
                                ? <a href={internalLink('alliance', identity.allianceID)} class="link">{identity.allianceName}</a>
                                : (identity.allianceName || 'Non Affiliate')}
                        </div>
                    </div>
                    <div class="dossier-badges">
                        {identity.corpID && (
                            <img src={`https://images.evetech.net/corporations/${identity.corpID}/logo?size=64`} alt="" loading="lazy" />
                        )}
                        {identity.allianceID && (
                            <img src={`https://images.evetech.net/alliances/${identity.allianceID}/logo?size=64`} alt="" loading="lazy" />
                        )}
                    </div>
                </div>

                <div class="dossier-rows">
                    {entityType === 'pilot' && identity.securityStatus != null && (
                        <div class="row">
                            <span class="k">SEC STATUS</span>
                            <span class="v">
                                <span class="chip" style={`--c:${secColor(identity.securityStatus)}`}>
                                    {identity.securityStatus.toFixed(1)}
                                </span>
                            </span>
                        </div>
                    )}

                    {entityType === 'corp' && (
                        <>
                            <div class="row">
                                <span class="k">MEMBERS</span>
                                <span class="v">{identity.memberCount ?? '—'}</span>
                            </div>
                            <div class="row">
                                <span class="k">WAR ELIGIBLE</span>
                                <span class="v" style={`color:${identity.warEligible ? 'var(--color-whale-accent)' : 'var(--color-text-faint)'}`}>
                                    {identity.warEligible ? 'YES' : 'NO'}
                                </span>
                            </div>
                            {identity.ceoName && (
                                <div class="row">
                                    <span class="k">CEO</span>
                                    <span class="v truncate">
                                        <a href={internalLink('character', identity.ceoID)} class="link">{identity.ceoName}</a>
                                    </span>
                                </div>
                            )}
                        </>
                    )}

                    <div class="row">
                        <span class="k">{entityType === 'pilot' ? 'CAPSULEER SINCE' : 'FOUNDED'}</span>
                        <span class="v">
                            {identity.founded ? new Date(identity.founded).getFullYear() : '—'}
                            <span class="sub"> · {ageOf(identity.founded)}</span>
                        </span>
                    </div>

                    {lostHull && (
                        <div class="row">
                            <span class="k">MOST LOST</span>
                            <span class="v truncate">{lostHull.name} <span class="sub">×{lostHull.n}</span></span>
                        </div>
                    )}

                    <div class="row" style="margin-top:0.35rem">
                        <span class="k">ENGAGEMENTS</span>
                        <span class="v">{events.length}{events.length >= 100 ? '+' : ''}</span>
                    </div>
                    <div class="row">
                        <span class="k">KILLS</span>
                        <span class="v" style="color:var(--color-neon-green)">{kills.length}</span>
                    </div>
                    <div class="row">
                        <span class="k">LOSSES</span>
                        <span class="v" style="color:var(--color-isk-billion)">{losses.length}</span>
                    </div>

                    {events.length > 0 && (
                        <div class="split-bar" title={`${killPct.toFixed(0)}% kills`}>
                            <span style={`width:${killPct}%`}></span>
                        </div>
                    )}
                </div>

                <div class="dossier-actions">
                    <a href={externalLink(conf.zkillType, id)} target="_blank" rel="noopener noreferrer" class="act act-primary">ZKILLBOARD</a>
                    <a href={`https://evewho.com/${conf.evewhoPath}/${id}`} target="_blank" rel="noopener noreferrer" class="act">EVEWHO</a>
                    <button type="button" id="copy-btn" data-url={canonicalUrl} class="act">COPY LINK</button>
                </div>

                <div class="card-f" style={`color:${events.length ? 'var(--color-neon-green)' : 'var(--color-text-faint)'}`}>
                    <span class="pulse-dot"></span>
                    status: {events.length ? `last seen ${relativeTime(events[0].time).toLowerCase()}` : 'no contact'}
                </div>
            </div>

            <!-- OPERATING AREA — location only, no performance metrics -->
            {events.length > 0 && (
                <div class="card" style="--card-c: var(--color-terminal-blue); --d: 60ms">
                    <div class="card-h">operating area</div>

                    <div class="dossier-rows">
                        {area.systems.map(s => {
                            const c = SPACE_CHIP[s.space]?.color ?? 'var(--color-text-faint)'
                            const pct = Math.round(s.n / area.total * 100)
                            return (
                                <div>
                                    <div class="row" style="margin-bottom:0.2rem">
                                        <span class="v truncate" style="text-align:left">
                                            <a href={externalLink('system', s.name)} target="_blank" rel="noopener noreferrer" class="link">{s.name}</a>
                                            <span class="sub"> {s.region}</span>
                                        </span>
                                        <span class="k">{s.n}</span>
                                    </div>
                                    <div class="bar-track">
                                        <div class="bar-fill" style={`--c:${c}; width:${pct}%`}></div>
                                    </div>
                                </div>
                            )
                        })}

                        <div class="flex" style="height:6px; margin-top:0.4rem">
                            {area.spaces.map(s => {
                                const c = SPACE_CHIP[s.k]?.color ?? 'var(--color-text-faint)'
                                return <div style={`width:${s.n / area.total * 100}%; background:${c}`}></div>
                            })}
                        </div>
                        <div class="flex flex-wrap gap-x-3 gap-y-1" style="font-size:11px">
                            {area.spaces.map(s => {
                                const m = SPACE_CHIP[s.k] ?? { label: '?', color: 'var(--color-text-faint)' }
                                return (
                                    <span class="chip" style={`--c:${m.color}`}>
                                        {m.label} {Math.round(s.n / area.total * 100)}%
                                    </span>
                                )
                            })}
                        </div>
                    </div>
                </div>
            )}
        </section>

        
        <section class="card self-start" style="--card-c: var(--color-neon-green); --d: 45ms">
            <div class="card-h flex justify-between items-center">
                <span>activity</span>
                {events.length > 0 && (
                    <div class="tabs" id="feed-tabs" role="tablist">
                        <button type="button" class="tab is-active" data-f="all" role="tab" aria-selected="true">ALL {events.length}</button>
                        <button type="button" class="tab" data-f="kills" role="tab" aria-selected="false">KILLS {kills.length}</button>
                        <button type="button" class="tab" data-f="losses" role="tab" aria-selected="false">LOSSES {losses.length}</button>
                    </div>
                )}
            </div>

            {!feedOnline ? (
                <div class="ui" style="padding:3rem 1rem; text-align:center">
                    <p style="letter-spacing:0.18em; text-transform:uppercase; color:var(--color-terminal-blue)" class="animate-pulse">
                        &gt; ACTIVITY UPLINK OFFLINE
                    </p>
                    <p style="font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--color-text-faint); margin-top:0.5rem">
                        record found — activity feed unavailable, try again shortly
                    </p>
                </div>
            ) : events.length === 0 ? (
                <div class="ui" style="padding:3rem 1rem; text-align:center">
                    <p class="grp" style="color:var(--color-text-faint)">
                        &gt; NO ACTIVITY IN THE LAST {windowDays} DAYS &lt;
                    </p>
                    <p style="font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--color-text-faint); opacity:0.6; margin-top:0.5rem">
                        quiet skies — or flying safe
                    </p>
                </div>
            ) : (
                <div id="feed">
                    {events.map(e => {
                        const chip = SPACE_CHIP[e.space] ?? { label: '?', color: 'var(--color-text-faint)' }
                        const accent = e.isLoss ? 'var(--color-isk-billion)' : 'var(--color-neon-green)'
                        return (
                            <a href={`/kill/${e.killID}`}
                               class="feed-row"
                               data-row
                               data-kind={e.isLoss ? 'loss' : 'kill'}
                               style={`--accent: ${accent}`}>
                                <img src={`https://images.evetech.net/types/${e.shipTypeID}/render?size=64`}
                                     alt="" style="width:2.5rem; height:2.5rem; flex-shrink:0" loading="lazy" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-baseline gap-2">
                                        <span class="grp flex-shrink-0" style={`color:${accent}`}>
                                            {e.isLoss ? conf.lossWord : 'KILL'}
                                        </span>
                                        <span class="nm truncate" style="font-size:0.875rem">
                                            {e.shipName}
                                        </span>
                                    </div>
                                    <div class="af" style="font-size:11px; color:var(--color-text-faint)">
                                        <span class="chip" style={`--c:${chip.color}`}>{chip.label}</span>
                                        <span style="margin-left:0.35rem">{e.systemName}</span>
                                        <span style="color:rgba(255,255,255,0.25); margin:0 0.25rem">·</span>
                                        <span>{e.regionName}</span>
                                    </div>
                                </div>
                                <div style="text-align:right; flex-shrink:0">
                                    <div style={`font-family:var(--font-mono); font-size:0.875rem; font-weight:700; font-variant-numeric:tabular-nums; color:${valueColor(e.totalValue)}`}>
                                        {formatIsk(e.totalValue)}
                                    </div>
                                    <div class="tag tabular-nums">
                                        {e.attackerCount > 1 ? `${e.attackerCount} INV` : 'SOLO'}
                                        <span style="color:rgba(255,255,255,0.25); margin:0 0.25rem">·</span>
                                        {relativeTime(e.time)}
                                    </div>
                                </div>
                            </a>
                        )
                    })}
                    <div id="feed-empty" class="ui" style="padding:2.5rem 1rem; text-align:center; color:var(--color-text-faint); letter-spacing:0.18em; text-transform:uppercase" hidden>
                        &gt; NO MATCHING ACTIVITY &lt;
                    </div>
                </div>
            )}

            <div class="card-f" style="color:var(--color-text-faint)">
                &gt; radar, not record — activity older than {windowDays} days is not retained ·
                <a href={externalLink(conf.zkillType, id)} target="_blank" rel="noopener noreferrer" class="link">FULL HISTORY</a>
            </div>
        </section>
    </main>

    <footer class="relative z-10 max-w-7xl mx-auto p-4 mt-8 border-t border-[var(--color-eve-border)]">
        <div class="ui flex flex-col md:flex-row justify-between items-center gap-4"
             style="font-size:11px; letter-spacing:0.14em; color:var(--color-text-faint)">
            <div><a href="/" class="link">&lt; BACK TO SOCKETKILL.COM</a></div>
            <div class="space-x-4">
                <a href="/about" class="link">ABOUT</a>
                <a href="https://github.com/ScotDex/socketkill-v2" target="_blank" rel="noopener" class="link">GITHUB</a>
                <a href="https://discord.gg/dpgmEm9REc" target="_blank" rel="noopener" class="link">DISCORD</a>
            </div>
            <div>&copy; SOCKETKILL.COM</div>
        </div>
    </footer>
</div>
</Base>

<script>
    const copyBtn = document.getElementById('copy-btn')
    const copyLabel = copyBtn?.textContent
    let copyTimer
    copyBtn?.addEventListener('click', async () => {
        const url = copyBtn.dataset.url || ''
        try {
            await navigator.clipboard.writeText(url)
        } catch {
            const ta = document.createElement('textarea')
            ta.value = url
            document.body.appendChild(ta)
            ta.select()
            document.execCommand('copy')
            ta.remove()
        }
        clearTimeout(copyTimer)
        copyBtn.textContent = 'COPIED ✓'
        copyTimer = setTimeout(() => { copyBtn.textContent = copyLabel }, 1500)
    })

    const tabs = document.getElementById('feed-tabs')
    const feed = document.getElementById('feed')

    if (tabs && feed) {
        const rows = [...feed.querySelectorAll('[data-row]')]
        const empty = document.getElementById('feed-empty')

        const apply = (mode) => {
            let anyVisible = false
            for (const row of rows) {
                const kind = row.dataset.kind
                const show = mode === 'all'
                    || (mode === 'kills' && kind === 'kill')
                    || (mode === 'losses' && kind === 'loss')
                row.hidden = !show
                if (show) anyVisible = true
            }
            if (empty) empty.hidden = anyVisible
        }

        tabs.addEventListener('click', (e) => {
            const active = e.target.closest('.tab')
            if (!active) return
            for (const t of tabs.querySelectorAll('.tab')) {
                t.classList.toggle('is-active', t === active)
                t.setAttribute('aria-selected', t === active ? 'true' : 'false')
            }
            apply(active.dataset.f)
        })
    }
</script>