---
import Base from '../../layouts/Base.astro'
import { externalLink } from '../../lib/entity-links.js'
import { formatIsk } from '../../lib/filter-logic.js'

// ── ROUTE: src/pages/[entityType]/[entityID].astro ───────────────────
// Serves /pilot/{id}, /corp/{id}, /alliance/{id}
// Static routes (/kill/, /about, /obs) take priority in Astro,
// so this only catches the three whitelisted types below.
//
// STATUS: BASELINE / BETA. Vibe-coded first pass — functional, not final.
// Structure is deliberately loose to leave room for iteration on the
// existing surface (rows, states, identity block). Do NOT grow this into
// stats/graphs/ratios — that is ledger territory, out of scope by design.
//
// DATA CONTRACT — implemented in webServer.js:
// GET https://ws.socketkill.com/api/entity/{type}/{id}
// 200: { windowDays, events: [{ killID, isLoss, shipTypeID, shipName,
//        systemName, regionName, space, totalValue, time, attackerCount }] }
// Identity is resolved here via public ESI, not by the endpoint.
// ─────────────────────────────────────────────────────────────────────

const ENTITY = {
    pilot: {
        label: 'PILOT',
        esiPath: id => `https://esi.evetech.net/latest/characters/${id}/`,
        image: id => `https://images.evetech.net/characters/${id}/portrait?size=128`,
        zkillType: 'character',
        lossWord: 'LOSS',
    },
    corp: {
        label: 'CORPORATION',
        esiPath: id => `https://esi.evetech.net/latest/corporations/${id}/`,
        image: id => `https://images.evetech.net/corporations/${id}/logo?size=128`,
        zkillType: 'corp',
        lossWord: 'LOSS',
    },
    alliance: {
        label: 'ALLIANCE',
        esiPath: id => `https://esi.evetech.net/latest/alliances/${id}/`,
        image: id => `https://images.evetech.net/alliances/${id}/logo?size=128`,
        zkillType: 'alliance',
        lossWord: 'LOSS',
    },
}

const { entityType, entityID } = Astro.params
const conf = ENTITY[entityType]
const id = parseInt(entityID)
if (!conf || !/^\d+$/.test(entityID ?? '') || !Number.isFinite(id) || id <= 0) {
    return new Response('Not found', { status: 404 })
}

// ── IDENTITY (public ESI) ────────────────────────────────────────────
let identity = null
try {
    const res = await fetch(conf.esiPath(id))
    if (!res.ok) return new Response('Entity not found', { status: 404 })
    const data = await res.json()

    identity = {
        name: data.name,
        ticker: data.ticker ?? null,
        corpID: entityType === 'pilot' ? (data.corporation_id ?? null) : null,
        allianceID: entityType !== 'alliance' ? (data.alliance_id ?? null) : null,
        corpName: null,
        allianceName: null,
    }

    if (identity.corpID) {
        const r = await fetch(`https://esi.evetech.net/latest/corporations/${identity.corpID}/`)
        if (r.ok) identity.corpName = (await r.json()).name
    }
    if (identity.allianceID) {
        const r = await fetch(`https://esi.evetech.net/latest/alliances/${identity.allianceID}/`)
        if (r.ok) identity.allianceName = (await r.json()).name
    }
} catch {
    return new Response('Entity lookup failed', { status: 502 })
}

// ── EVENTS (SocketKill D1 endpoint) ──────────────────────────────────
let events = []
let windowDays = 30
let feedOnline = false
try {
    const res = await fetch(`https://ws.socketkill.com/api/entity/${entityType}/${id}`, {
        headers: { 'User-Agent': Astro.request.headers.get('user-agent') || 'SocketKill-Frontend/1.0' }
    })
    if (res.ok) {
        const data = await res.json()
        events = data.events ?? []
        windowDays = data.windowDays ?? 30
        feedOnline = true
    }
} catch { /* endpoint unreachable — offline state below */ }

Astro.response.headers.set('Cache-Control', 'public, max-age=60')

const kills = events.filter(e => !e.isLoss)
const losses = events.filter(e => e.isLoss)

function relativeTime(iso) {
    const diff = Date.now() - new Date(iso).getTime()
    const m = Math.floor(diff / 60000)
    if (m < 1) return 'JUST NOW'
    if (m < 60) return `${m}M AGO`
    const h = Math.floor(m / 60)
    if (h < 24) return `${h}H AGO`
    return `${Math.floor(h / 24)}D AGO`
}

const SPACE_CHIP = {
    high:    { label: 'HS',   color: 'var(--color-neon-green)' },
    low:     { label: 'LS',   color: 'var(--color-whale-accent)' },
    null:    { label: 'NULL', color: 'var(--color-isk-billion)' },
    wh:      { label: 'WH',   color: 'var(--color-terminal-blue)' },
    pochven: { label: 'PCH',  color: '#b07ce8' },
}

function valueColor(v) {
    if (v >= 10_000_000_000) return 'var(--color-whale-accent)'
    if (v >= 1_000_000_000) return 'var(--color-isk-billion)'
    return 'var(--color-neon-green)'
}

const displayName = identity.ticker ? `${identity.name} [${identity.ticker}]` : identity.name
const title = `${identity.name} — ${conf.label.charAt(0) + conf.label.slice(1).toLowerCase()} Activity`
---

<Base title={`${title} | Socketkill.com`} ogTitle={title}
    ogDescription={`Recent kills and losses for ${identity.name} — last ${windowDays} days, live from SocketKill.`}>
    <div class="kill-screen">
        <main class="relative z-10 max-w-4xl mx-auto px-4 py-8">

            <!-- DEV NOTICE — self-contained, dismissible, session-only -->
            <div id="beta-notice" class="fade-card mb-5 flex items-start gap-3 border border-[var(--color-terminal-blue)]/40 bg-[var(--color-terminal-blue)]/[0.04] px-4 py-3">
                <span class="font-mono text-[11px] tracking-[0.16em] uppercase text-[var(--color-terminal-blue)] shrink-0 mt-0.5" style="text-shadow: 0 0 6px color-mix(in srgb, var(--color-terminal-blue) 40%, transparent)">&#9679; BETA</span>
                <p class="font-mono text-[11px] leading-relaxed text-[var(--color-text-faint)] flex-1">
                    Entity profiles are an early baseline — functional, not finished. Layout and detail will change as this is built out. Activity reflects the last {windowDays} days only; this is a live radar, not a historical record.
                </p>
                <button type="button" id="beta-dismiss" aria-label="Dismiss notice"
                    class="shrink-0 font-mono text-[11px] tracking-[0.14em] text-[var(--color-text-faint)] hover:text-[var(--color-terminal-blue)] transition-colors">[X]</button>
            </div>

            <!-- IDENTITY -->
            <header class="fade-card flex items-center gap-4 border-b border-[var(--color-border-dim)] pb-5 mb-6">
                <img
                    src={conf.image(id)}
                    alt={identity.name}
                    class="w-20 h-20 border border-[var(--color-border-mid)]"
                    loading="eager"
                />
                <div class="min-w-0 flex-1">
                    <p class="font-mono text-[10px] tracking-[0.24em] uppercase text-[var(--color-text-faint)] flex items-center gap-2">
                        {conf.label}
                        <span class="px-1.5 py-0.5 border border-[var(--color-terminal-blue)]/50 text-[var(--color-terminal-blue)] tracking-[0.18em] text-[9px]" style="text-shadow: 0 0 6px color-mix(in srgb, var(--color-terminal-blue) 40%, transparent)">BETA</span>
                    </p>
                    <h1 class="kill-headline truncate">{displayName}</h1>
                    <p class="kill-sub truncate">
                        {identity.corpID
                            ? <a href={externalLink('corp', identity.corpID)} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-neon-green)] transition-colors">{identity.corpName ?? '—'}</a>
                            : identity.corpName}
                        {identity.allianceName && <span> {identity.corpName ? '// ' : ''}{identity.allianceID
                            ? <a href={externalLink('alliance', identity.allianceID)} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-neon-green)] transition-colors">{identity.allianceName}</a>
                            : identity.allianceName}</span>}
                    </p>
                </div>
                <div class="flex gap-2 shrink-0">
                    {identity.corpID && <img src={`https://images.evetech.net/corporations/${identity.corpID}/logo?size=64`} alt="" class="w-10 h-10" loading="lazy" />}
                    {identity.allianceID && <img src={`https://images.evetech.net/alliances/${identity.allianceID}/logo?size=64`} alt="" class="w-10 h-10" loading="lazy" />}
                </div>
            </header>

            <!-- WINDOW BANNER — the radar-not-ledger declaration, always visible -->
            <div class="fade-card flex items-center justify-between mb-5 font-mono text-[11px] tracking-[0.2em] uppercase">
                <span class="text-[var(--color-neon-green)]" style="text-shadow: var(--shadow-phosphor)">&gt; RECENT ACTIVITY // LAST {windowDays} DAYS</span>
                <span class="text-[var(--color-text-faint)] tabular-nums">
                    <span class="text-[var(--color-neon-green)]">{kills.length} KILLS</span>
                    <span class="mx-1 text-white/20">/</span>
                    <span class="text-[var(--color-isk-billion)]">{losses.length} LOSSES</span>
                    {events.length >= 100 && <span class="ml-2 text-[var(--color-text-faint)]/60">(LATEST 100)</span>}
                </span>
            </div>

            <!-- FEED -->
            {!feedOnline ? (
                <div class="fade-card flex flex-col items-center justify-center min-h-[240px] border border-dashed border-[var(--color-eve-border)] bg-[var(--color-eve-dark)]/30">
                    <span class="font-mono text-sm tracking-[0.18em] uppercase text-[var(--color-terminal-blue)] animate-pulse">&gt; ACTIVITY UPLINK OFFLINE</span>
                    <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-[var(--color-text-faint)] mt-2">record found — activity feed unavailable, try again shortly</span>
                </div>
            ) : events.length === 0 ? (
                <div class="fade-card flex flex-col items-center justify-center min-h-[240px] border border-dashed border-[var(--color-eve-border)] bg-[var(--color-eve-dark)]/30">
                    <span class="font-mono text-sm tracking-[0.18em] uppercase text-[var(--color-text-faint)]">&gt; NO ACTIVITY IN THE LAST {windowDays} DAYS &lt;</span>
                    <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-[var(--color-text-faint)]/60 mt-2">quiet skies — or flying safe</span>
                </div>
            ) : (
                <ul class="fade-card border border-[var(--color-border-dim)] bg-[var(--color-feed-bg)]/40 divide-y divide-[var(--color-border-dim)]/50">
                    {events.map(e => {
                        const chip = SPACE_CHIP[e.space] ?? { label: '?', color: 'var(--color-text-faint)' }
                        return (
                        <li>
                            <a href={`/kill/${e.killID}`}
                               class="flex items-center gap-3 px-3 py-2.5 border-l-[3px] hover:bg-white/[0.03] transition-colors"
                               style={`border-left-color: ${e.isLoss ? 'var(--color-isk-billion)' : 'var(--color-neon-green)'}`}>
                                <img src={`https://images.evetech.net/types/${e.shipTypeID}/render?size=64`}
                                     alt="" class="w-10 h-10 shrink-0" loading="lazy" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-baseline gap-2">
                                        <span class="font-mono text-[10px] tracking-[0.16em] uppercase shrink-0"
                                              style={`color: ${e.isLoss ? 'var(--color-isk-billion)' : 'var(--color-neon-green)'}`}>
                                            {e.isLoss ? conf.lossWord : 'KILL'}
                                        </span>
                                        <span class="ship-name text-sm font-semibold text-[var(--color-text-body)] truncate">{e.shipName}</span>
                                    </div>
                                    <div class="font-mono text-[11px] text-[var(--color-text-faint)] truncate">
                                        <span class="chip" style={`--c:${chip.color}; color:${chip.color}`}>{chip.label}</span>
                                        <span class="ml-1.5">{e.systemName}</span>
                                        <span class="text-white/25 mx-1">·</span>
                                        <span>{e.regionName}</span>
                                    </div>
                                </div>
                                <div class="text-right shrink-0">
                                    <div class="font-mono text-sm font-bold tabular-nums" style={`color: ${valueColor(e.totalValue)}`}>{formatIsk(e.totalValue)}</div>
                                    <div class="font-mono text-[10px] tracking-[0.14em] text-[var(--color-text-faint)] tabular-nums">
                                        {e.attackerCount > 1 ? `${e.attackerCount} INV` : 'SOLO'}
                                        <span class="text-white/25 mx-1">·</span>
                                        {relativeTime(e.time)}
                                    </div>
                                </div>
                            </a>
                        </li>
                        )
                    })}
                </ul>
            )}

            <!-- RADAR DISCLAIMER -->
            <p class="fade-card mt-4 font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-text-faint)]/50 text-center">
                socketkill is a radar, not a record — activity older than {windowDays} days is not retained
            </p>

            <!-- FOOTER -->
            <footer class="mt-8 border-t border-[var(--color-eve-border)] pt-4 text-center">
                <div class="font-mono text-[11px] tracking-[0.14em] text-[var(--color-text-faint)] space-x-4">
                    <a href="/" class="hover:text-[var(--color-neon-green)] transition-colors">&lt; BACK TO SOCKETKILL.COM</a>
                    <a href={externalLink(conf.zkillType, id)} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-neon-green)] transition-colors">FULL HISTORY ON ZKILLBOARD</a>
                </div>
            </footer>

        </main>
    </div>
</Base>

<script>
    // Dev notice dismiss — session-scoped, in-memory only (no storage APIs).
    // Re-appears on hard refresh by design; it's a beta signal, not a nag.
    const notice = document.getElementById('beta-notice')
    const dismiss = document.getElementById('beta-dismiss')
    if (notice && dismiss) {
        dismiss.addEventListener('click', () => notice.remove())
    }
</script>