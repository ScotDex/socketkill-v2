---
import Base from '../../layouts/Base.astro'
import { externalLink } from '../../lib/entity-links.js'
import { formatIsk } from '../../lib/helpers.js'
import '../kill/style.css'
import './style.css'
import { ENTITY, FACTION, spaceOf, normaliseSpace } from '../../lib/entity-constants.js'
import { analyseEvents, pad2 } from '../../lib/entity-stats.js'

const { entityType, entityID } = Astro.params
const conf = ENTITY[entityType]
const id = parseInt(entityID)
if (!conf || !/^\d+$/.test(entityID ?? '') || !Number.isFinite(id) || id <= 0) {
    return new Response('Not found', { status: 404 })
}
const ESI_HEADERS = { 'X-Compatibility-Date': '2026-08-14' }
async function fetchJson(url, { ms = 4000, headers } = {}) {
    const ctrl = new AbortController()
    const timer = setTimeout(() => ctrl.abort(), ms)
    try {
        const res = await fetch(url, { signal: ctrl.signal, headers })
        if (!res.ok) return { ok: false, status: res.status }
        return { ok: true, data: await res.json() }
    } catch {
        return { ok: false, status: 0 }
    } finally {
        clearTimeout(timer)
    }
}

const isAlliance = entityType === 'alliance'
const isPilot = entityType === 'pilot'
const isCorp = entityType === 'corp'
const [identityRes, activityRes, memberCorpsRes] = await Promise.all([
    fetchJson(conf.esiPath(id), { headers: ESI_HEADERS }),
    fetchJson(conf.esiPath(id)),
    fetchJson(`https://ws.socketkill.com/api/entity/${entityType}/${id}`, { ms: 5000 }),
    isAlliance ? fetchJson(`https://esi.evetech.net/alliances/${id}/corporations/`) : null,
])

if (!identityRes.ok) {
    return new Response('Entity not found', {
        status: identityRes.status === 404 ? 404 : 502,
    })
}
const raw = identityRes.data

const corpID = isPilot ? (raw.corporation_id ?? null) : null
const allianceID = !isAlliance ? (raw.alliance_id ?? null) : null
const ceoID = isCorp ? (raw.ceo_id ?? null) : null
const executorID = isAlliance ? (raw.executor_corporation_id ?? null) : null
const factionID = raw.faction_id ?? null

const corpTitle = isPilot
    ? ((raw.corporation_title ?? '').replace(/<[^>]*>/g, '').trim().slice(0, 40) || null)
    : null

/* Wave 2 — name lookups that genuinely depend on wave 1's IDs. */
const [corpRes, allianceRes, ceoRes, executorRes] = await Promise.all([
    corpID ? fetchJson(`https://esi.evetech.net/corporations/${corpID}/`) : null,
    allianceID ? fetchJson(`https://esi.evetech.net/alliances/${allianceID}/`) : null,
    ceoID ? fetchJson(`https://esi.evetech.net/characters/${ceoID}/`) : null,
    executorID ? fetchJson(`https://esi.evetech.net/corporations/${executorID}/`) : null,
])

const identity = {
    name: raw.name,
    ticker: raw.ticker ?? null,
    corpID,
    allianceID,
    ceoID,
    executorID,
    factionID,
    corpTitle,
    faction: factionID ? (FACTION[factionID] ?? null) : null,
    corpName: corpRes?.ok ? corpRes.data.name : null,
    allianceName: allianceRes?.ok ? allianceRes.data.name : null,
    ceoName: ceoRes?.ok ? ceoRes.data.name : null,
    executorName: executorRes?.ok ? executorRes.data.name : null,
    corpCount: memberCorpsRes?.ok ? memberCorpsRes.data.length : null,
    founded: raw.birthday ?? raw.date_founded ?? null,
    securityStatus: raw.security_status ?? null,
    memberCount: raw.member_count ?? null,
    warEligible: raw.war_eligible ?? null,
    taxRate: raw.tax_rates?.isk ?? null,
    friendlyFire: raw.friendly_fire ?? null,
    cardTint: cardTint(raw.palette),
}

const feedOnline = activityRes.ok
const events = feedOnline ? (activityRes.data.events ?? []) : []
const windowDays = feedOnline ? (activityRes.data.windowDays ?? 30) : 30

const now = Date.now()

const HEX = /^#(?:[0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$/i

function cardTint(palette) {
    const c = palette?.main_color
    if (typeof c !== 'string' || !HEX.test(c)) return 'var(--dossier-c)'
    return `color-mix(in srgb, var(--dossier-c) 75%, ${c} 25%)`
}

const {
    total, killCount, lossCount, iskDestroyed, iskLost,
    histK, histL, histMax, hourTotals,
    peak, peakLabel,
    tzLabel, spaceTally, systemCount,
    topSystem, topKilledHull,
    trendDir, trendText, profile,
    lastEvent, status,
    byDay,
} = analyseEvents(events, windowDays, feedOnline, now)


Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300')

const entityHref = (kind, entId) => `/${kind}/${entId}`

function relativeTime(iso) {
    const m = Math.floor((now - Date.parse(iso)) / 60000)
    if (m < 1) return 'JUST NOW'
    if (m < 60) return `${m}M AGO`
    const h = Math.floor(m / 60)
    return h < 24 ? `${h}H AGO` : `${Math.floor(h / 24)}D AGO`
}

function secColor(s) {
    if (s == null) return 'var(--color-text-faint)'
    if (s <= -5) return 'var(--color-isk-billion)'
    if (s < 0) return 'var(--color-whale-accent)'
    return 'var(--color-neon-green)'
}

function valueColor(v) {
    if (v >= 10_000_000_000) return 'var(--color-whale-accent)'
    if (v >= 1_000_000_000) return 'var(--color-isk-billion)'
    return 'var(--color-neon-green)'
}

const displayName = identity.ticker ? `${identity.name} [${identity.ticker}]` : identity.name
const pageTitle = `${identity.name} — ${conf.label.charAt(0)}${conf.label.slice(1).toLowerCase()} Activity`
const canonicalUrl = `https://socketkill.com/${entityType}/${id}`


const KILLS_BG_COUNT = 24
const entityBg = `https://edge.socketkill.com/kills/kills-${String((id % KILLS_BG_COUNT) + 1).padStart(3, '0')}.webp`
const dayViews = byDay.map(bucket => ({
    day: bucket.day,
    kills: bucket.kills,
    losses: bucket.losses,
    rows: bucket.rows.map(e => {
        const sp = spaceOf(normaliseSpace(e.space))
        return {
            killID: e.killID,
            isLoss: e.isLoss,
            accent: e.isLoss ? 'var(--color-isk-billion)' : 'var(--color-neon-green)',
            hhmm: (e.time ?? '').slice(11, 16),
            shipTypeID: e.shipTypeID,
            shipName: e.shipName,
            spShort: sp.short,
            spColor: sp.c,
            systemName: e.systemName,
            regionName: e.regionName,
            gang: e.attackerCount > 1 ? e.attackerCount : 'solo',
            isk: formatIsk(e.totalValue),
            iskColor: valueColor(e.totalValue),
        }
    }),
}))
---

<Base
    title={`${pageTitle} | Socketkill.com`}
    ogTitle={pageTitle}
    ogDescription={`Recent kills and losses for ${identity.name} — last ${windowDays} days, live from SocketKill.`}
    ogUrl={canonicalUrl}
    ogImage={`https://ws.socketkill.com/og/entity/${entityType}/${id}`}
>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://images.evetech.net" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Nunito+Sans:wght@400;500;600&family=Share+Tech+Mono&display=swap" rel="stylesheet">

<div class="kill-screen entity-screen art-bg" style={`--art-bg-url: url(${entityBg})`}>

    <div class="max-w-[84rem] mx-auto px-4 pt-6 relative z-10">
        <div class="flex justify-between items-end gap-4 flex-wrap">
            <div>
                <h1 class="kill-headline">{displayName}</h1>
                <p class="kill-sub">{conf.label} &nbsp;|&nbsp; LAST {windowDays} DAYS</p>
            </div>
            <div class="status inline-flex items-center gap-2 px-2 py-1 whitespace-nowrap"
                 style={`--s-c: ${status.color}; --dot-c: ${status.color}`}>
                {status.live && <span class="pulse-dot"></span>}
                <span>{lastEvent ? `${status.text} · ${relativeTime(lastEvent.time)}` : status.text}</span>
            </div>
        </div>
    </div>

    <main class="grid grid-cols-1 lg:grid-cols-[380px_minmax(0,1fr)] gap-4 p-4 max-w-[84rem] mx-auto relative z-10 items-start">

        <aside class="lg:sticky lg:top-4">
            <div class="card" style={`--card-c: ${identity.cardTint}; --d: 0ms`}>
                <div class="card-h flex justify-between items-center">
                    <span>{conf.label.toLowerCase()}</span>
                    <span class="tag">{windowDays}-DAY WINDOW</span>
                </div>

                {topKilledHull && (
                    <figure class="cover" style="margin:0">
                        <img src={`https://images.evetech.net/types/${topKilledHull[0]}/render?size=512`}
                             width="512" height="512" alt="" loading="lazy" decoding="async" />
                    </figure>
                )}

                <div class="ident" style={topKilledHull ? undefined : 'margin-top:0.75rem'}>
                    <img class="portrait-sm" src={conf.image(id)} width="128" height="128"
                         alt={identity.name} loading="eager" decoding="async" />
                    <div class="who">
                        <div class="nm truncate">{identity.name}</div>
                        <div class="af">
                            {identity.corpID
                                ? <a href={entityHref('corp', identity.corpID)} class="link">{identity.corpName ?? '—'}</a>
                                : (identity.ticker ? `[${identity.ticker}]` : '')}
                            {identity.corpTitle && (
                                <span style="color:var(--color-text-faint)"> · {identity.corpTitle}</span>
                            )}
                        </div>
                        {identity.allianceID && (
                            <div class="af">
                                <a href={entityHref('alliance', identity.allianceID)} class="link">{identity.allianceName ?? '—'}</a>
                            </div>
                        )}
                    </div>
                    <div class="dossier-badges">
                        {identity.corpID && (
                            <img src={`https://images.evetech.net/corporations/${identity.corpID}/logo?size=64`}
                                 width="64" height="64" alt="" loading="lazy" decoding="async" />
                        )}
                        {identity.allianceID && (
                            <img src={`https://images.evetech.net/alliances/${identity.allianceID}/logo?size=64`}
                                 width="64" height="64" alt="" loading="lazy" decoding="async" />
                        )}
                    </div>
                </div>

                <div class="dossier-rows">
                    {isPilot && identity.securityStatus != null && (
                        <div class="row">
                            <span class="k">SEC STATUS</span>
                            <span class="v">
                                <span class="chip" style={`--c:${secColor(identity.securityStatus)}`}>
                                    {identity.securityStatus.toFixed(1)}
                                </span>
                            </span>
                        </div>
                    )}

                    {isAlliance && (
                        <>
                            <div class="row">
                                <span class="k">CORPORATIONS</span>
                                <span class="v">{identity.corpCount?.toLocaleString() ?? '—'}</span>
                            </div>
                            {identity.executorName && (
                                <div class="row">
                                    <span class="k">EXECUTOR</span>
                                    <span class="v truncate">
                                        <a href={entityHref('corp', identity.executorID)} class="link">{identity.executorName}</a>
                                    </span>
                                </div>
                            )}
                        </>
                    )}

                    {isCorp && (
                        <>
                            <div class="row">
                                <span class="k">MEMBERS</span>
                                <span class="v">{identity.memberCount?.toLocaleString() ?? '—'}</span>
                            </div>
                            <div class="row">
                                <span class="k">TAX RATE</span>
                                <span class="v">{identity.taxRate != null ? `${identity.taxRate}%` : '—'}</span>
                                </div>
                            <div class="row">
                                <span class="k">WAR ELIGIBLE</span>
                                <span class="v" style={`color:${identity.warEligible ? 'var(--color-whale-accent)' : 'var(--color-text-faint)'}`}>
                                    {identity.warEligible ? 'YES' : 'NO'}
                                </span>
                            </div>
                            
                            {identity.friendlyFire && (
                                <div class="row">
                                    <span class="k">FRIENDLY FIRE</span>
                                    <span class="v" style={`color:${identity.friendlyFire === 'illegal' ? 'var(--color-text-faint)' : 'var(--color-whale-accent)'}`}>
                                        {identity.friendlyFire.toUpperCase()}
                                    </span>
                                </div>
                            )}
                            {identity.ceoName && (
                                <div class="row">
                                    <span class="k">CEO</span>
                                    <span class="v truncate">
                                        <a href={entityHref('pilot', identity.ceoID)} class="link">{identity.ceoName}</a>
                                    </span>
                                </div>
                            )}
                        </>
                    )}

                    {identity.factionID && (
                        <div class="row">
                            <span class="k">MILITIA</span>
                            <span class="v truncate">
                                {identity.faction
                                    ? <span class="chip" style={`--c:${identity.faction.c}`}>{identity.faction.short}</span>
                                    : <span class="chip" style="--c:var(--color-text-faint)">FACTION {identity.factionID}</span>}
                            </span>
                        </div>
                    )}

                    <div class="row">
                        <span class="k">{isPilot ? 'CAPSULEER SINCE' : 'FOUNDED'}</span>
                        <span class="v">{identity.founded ? identity.founded.slice(0, 4) : '—'}</span>
                    </div>
                </div>

                <div class="flex justify-between items-baseline border-b border-[color-mix(in_srgb,var(--color-neon-green)_18%,transparent)] mx-3 pb-1 mb-2 mt-1">
                    <span class="grp">Report Summary</span>
                </div>

                <div class="assess px-3 pb-2">
                    {total > 0 ? (
                        <>
                            <p><span>killmails</span><b>{total} — {killCount} kills, {lossCount} losses</b></p>
                            <p><span>isk</span><b>
                                <span style="color:var(--color-neon-green)">{formatIsk(iskDestroyed)}</span> killed,
                                <span style="color:var(--color-isk-billion)">{formatIsk(iskLost)}</span> lost
                            </b></p>
                            {tzLabel && <p><span>timezone</span><b class="hi">{tzLabel}</b></p>}
                            {topSystem && (
                                <p><span>most seen</span><b>{topSystem.name} ({topSystem.pct}%){topSystem.region ? `, ${topSystem.region}` : ''}</b></p>
                            )}
                            {spaceTally[0] && (
                                <p><span>most active</span><b>{spaceOf(spaceTally[0][0]).label} {Math.round(spaceTally[0][1] / total * 100)}%</b></p>
                            )}
                            <p><span>gang size</span><b>{profile}</b></p>
                            <p><span>trend</span><b>
                                {trendDir && (
                                    <span style={`color:${trendDir === 'up' ? 'var(--color-neon-green)' : 'var(--color-isk-billion)'}`}>
                                        {trendDir === 'up' ? '▲' : '▼'}
                                    </span>
                                )}
                                {trendDir ? ' ' : ''}{trendText}
                            </b></p>
                        </>
                    ) : (
                        <>
                            <p>{feedOnline ? 'Nothing to report here for the past 30 days...' : 'activity uplink unreachable'}</p>
                            <p>{feedOnline ? 'inactive, docked, or flying safe' : 'retry shortly'}</p>
                            <p>identity confirmed via esi</p>
                        </>
                    )}
                </div>

                {total > 0 && (
                    <>
                        <div class="flex justify-between items-baseline border-b border-[color-mix(in_srgb,var(--color-neon-green)_18%,transparent)] mx-3 pb-1 mb-2">
                            <span class="grp">Activity By Timezone</span>
                            <span class="tag">{peakLabel}</span>
                        </div>
                        <div class="px-3 pb-1 relative">
                            <div class="clock-grid">
                                {hourTotals.map((_, h) => (
                                    <div class="ck" title={`${pad2(h)}:00 — ${histK[h]} kills, ${histL[h]} losses`}>
                                        <div class="ck-up"><span style={`height:${histK[h] / histMax * 100}%`}></span></div>
                                        <div class="ck-dn"><span style={`height:${histL[h] / histMax * 100}%`}></span></div>
                                    </div>
                                ))}
                                <div class="clock-now" data-clock-now></div>
                                {peak && <div class="peak-band" style={`left:${peak.start / 24 * 100}%; width:12.5%`}></div>}
                            </div>
                            <div class="flex justify-between font-mono text-[9px] tracking-widest text-[var(--color-text-faint)] pt-1">
                                <span>00</span><span>06</span><span>12</span><span>18</span><span>23 EVE</span>
                            </div>
                        </div>

                        <div class="flex justify-between items-baseline border-b border-[color-mix(in_srgb,var(--color-neon-green)_18%,transparent)] mx-3 pb-1 mb-2 mt-2">
                            <span class="grp">Most Active Areas</span>
                            <span class="tag">{systemCount.size} SYSTEMS</span>
                        </div>
                        <div class="px-3 pb-2">
                            <div class="split-bar mix">
                                {spaceTally.map(([s, n]) => (
                                    <span style={`--c:${spaceOf(s).c}; width:${n / total * 100}%`}></span>
                                ))}
                            </div>
                            <div class="split-legend flex-wrap gap-x-3">
                                {spaceTally.map(([s, n]) => (
                                    <span style={`--c:${spaceOf(s).c}; color:${spaceOf(s).c}`}>
                                        {spaceOf(s).short} {Math.round(n / total * 100)}%
                                    </span>
                                ))}
                            </div>
                        </div>
                    </>
                )}

                <div class="dossier-actions">
                    <a href={externalLink(conf.zkillType, id)} target="_blank" rel="noopener noreferrer" class="act act-primary">ZKILLBOARD</a>
                    <a href={`https://evewho.com/${conf.evewhoPath}/${id}`} target="_blank" rel="noopener noreferrer" class="act">EVEWHO</a>
                    <button type="button" id="copy-btn" data-url={canonicalUrl} class="act">COPY LINK</button>
                </div>

                <div class="card-f" style={`color:${status.color}; --dot-c:${status.color}`}>
                    {status.live && <span class="pulse-dot"></span>}
                    {lastEvent
                        ? `last seen ${lastEvent.systemName} · ${relativeTime(lastEvent.time).toLowerCase()}`
                        : (feedOnline ? 'no contact in window' : 'activity feed unavailable')}
                </div>
            </div>
        </aside>

        <div class="card" style="--card-c: var(--dossier-c); --d: 60ms">
            <div class="card-h flex justify-between items-center sticky top-0 z-[4] bg-[var(--color-glass-bg)]">
                <span class="flex items-center gap-2">
                    killmails
                    <span class="status px-1.5 py-0.5"
                          style="--s-c: var(--color-whale-accent); color: var(--color-whale-accent); font-size: 9px; text-shadow: none">BETA</span>
                </span>
                {total > 0 && (
                    <div class="tabs" id="f-tabs" role="tablist">
                        <button type="button" class="tab is-active" data-f="all" role="tab" aria-selected="true">ALL {total}</button>
                        <button type="button" class="tab" data-f="kill" role="tab" aria-selected="false">KILLS {killCount}</button>
                        <button type="button" class="tab" data-f="loss" role="tab" aria-selected="false">LOSSES {lossCount}</button>
                    </div>
                )}
            </div>

            {total === 0 ? (
                <div class="ui p-10 text-center">
                    <span class="grp block" style="color:var(--color-text-faint)">
                        &gt; {feedOnline ? `${windowDays}-DAY WINDOW CLEAR` : 'ACTIVITY UNREACHABLE'} &lt;
                    </span>
                    <p class="font-mono text-[11px] tracking-wider text-[var(--color-text-faint)] mt-2">
                        {feedOnline ? 'nothing seen — full history on zkillboard' : 'identity confirmed, feed unavailable — retry shortly'}
                    </p>
                </div>
            ) : (
                <div id="feed">
                    {dayViews.map(bucket => (
                        <div data-day>
                            <div class="card-f flex justify-between" style="color:var(--color-text-faint)">
                                <span>{bucket.day}</span>
                                <span>{bucket.kills} kills · {bucket.losses} losses</span>
                            </div>
                            {bucket.rows.map(r => (
                                <a href={`/kill/${r.killID}`} class="fr px-3 py-1"
                                   data-kind={r.isLoss ? 'loss' : 'kill'}
                                   style={`--accent:${r.accent}`}>
                                    <span class="font-mono text-[11px]" style={`color:${r.accent}`}>{r.isLoss ? '✕' : '✓'}</span>
                                    <span class="font-mono text-xs tabular-nums text-[var(--color-text-faint)]">{r.hhmm}</span>
                                    <img src={`https://images.evetech.net/types/${r.shipTypeID}/render?size=64`}
                                         class="w-[26px] h-[26px] object-cover bg-black/50"
                                         width="64" height="64" alt="" loading="lazy" decoding="async" />
                                    <span class="text-sm text-white truncate">{r.shipName}</span>
                                    <span class="fr-hide text-xs truncate">
                                        <span class="chip" style={`--c:${r.spColor}`}>{r.spShort}</span>
                                        <span class="ml-1.5">{r.systemName}</span>
                                        <span class="text-[var(--color-text-faint)] ml-1.5">{r.regionName}</span>
                                    </span>
                                    <span class="fr-hide font-mono text-[11px] tabular-nums text-right text-[var(--color-text-faint)]">
                                        {r.gang}
                                    </span>
                                    <span class="font-mono text-sm tabular-nums text-right"
                                          style={`color:${r.iskColor}`}>{r.isk}</span>
                                </a>
                            ))}
                        </div>
                    ))}
                    <div id="feed-empty" class="ui p-10 text-center" hidden>
                        <span class="grp block" style="color:var(--color-text-faint)">&gt; NO MATCHING KILLMAILS &lt;</span>
                    </div>
                    <button type="button" id="feed-more" class="more" style="width:100%" hidden>LOAD MORE</button>
                </div>
            )}

            <div class="card-f" style="color:var(--color-text-faint)">
                &gt; killmails older than {windowDays} days are not displayed ·
                <a href={externalLink(conf.zkillType, id)} target="_blank" rel="noopener noreferrer" class="link">FULL HISTORY</a>
            </div>
        </div>
    </main>

    <footer class="relative z-10 max-w-[84rem] mx-auto p-4 mt-8 border-t border-[var(--color-eve-border)]">
        <div class="ui flex flex-col md:flex-row justify-between items-center gap-4 text-[11px] tracking-[0.14em] text-[var(--color-text-faint)]">
            <a href="/" class="link">&lt; BACK TO SOCKETKILL.COM</a>
            <div class="space-x-4">
                <a href="/about" class="link">ABOUT</a>
                <a href="https://github.com/ScotDex/socketkill-v2" target="_blank" rel="noopener" class="link">GITHUB</a>
                <a href="https://discord.gg/dpgmEm9REc" target="_blank" rel="noopener" class="link">DISCORD</a>
            </div>
            <span>&copy; SOCKETKILL.COM</span>
        </div>
    </footer>
</div>
</Base>

<script src="./_script.js"></script>