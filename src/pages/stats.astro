---
import Base from '../layouts/Base.astro'
import TopTen from '../components/svelte/TopTen.svelte'

const KILLS_BG_COUNT = 24; 
const artBg = `https://edge.socketkill.com/kills/kills-${String(Math.floor(Math.random() * KILLS_BG_COUNT) + 1).padStart(3, '0')}.webp`;
---

<Base
  title="Top 10 — Socket.Kill"
  ogTitle="Top 10 — Socket.Kill"
  ogDescription="The last hour of EVE Online destruction, ranked. Busiest systems, regions, most-destroyed ships, and the corps and alliances losing the most."
  ogUrl="https://socketkill.com/top"
>
  <div class="crt-screen art-bg max-w-[1700px] mx-auto px-4 py-3 pb-12" style={`--art-bg-url: url(${artBg})`}>
    <main class="mt-4">
      <TopTen client:only="svelte" />
    </main>
  </div>
</Base>