---
import Base from '../layouts/Base.astro'
import TopTen from '../components/svelte/TopTen.svelte'
import SiteFooter from '../components/astro/SiteFooter.astro'
---

<Base
  title="Top 10 — Socket.Kill"
  ogTitle="Top 10 — Socket.Kill"
  ogDescription="The last hour of EVE Online destruction, ranked. Busiest systems, regions, most-destroyed ships, and the corps and alliances bleeding the most."
  ogUrl="https://socketkill.com/top"
>
  <div class="crt-screen max-w-[1700px] mx-auto px-4 py-3 pb-12">
    <main class="mt-4">
      <TopTen client:only="svelte" />
    </main>
  </div>
  <SiteFooter />
</Base>