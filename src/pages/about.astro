---
import Base from '../layouts/Base.astro'
import ReferralSlot from '../components/astro/ReferralSlot.astro'

const faqSections = [
    {
        title: "The Application",
        items: [
            {
                q: "What is Socket.Kill?",
                a: "The design is optimised to deliver killmails as fast as the internet allows, streamlining every step of the rendering process. The idea was to see how fast a kill could travel from the endpoint to the front page."
            },
            {
                q: "How is this different from zKill or Eve-Kill?",
                a: "Both keep the historical record — stats, history, deep detail. Socket.Kill is a live feed focused on low latency. They are complementary tools, not competitors; the idea is to use both."
            },
            {
                q: "Can I filter the feed?",
                a: "Yes. Type a corp, alliance, system or region name and the feed filters to matching kills. You can chain those options together to build your own view."
            },
            {
                q: "What the hell is this search killmails engine?",
                a: "I had all this data lying around and figured I would use it to extend the site. You can now chain a query together and look at kills since 00:01 UTC."
            },
            {
                q: "What's with the green-on-black aesthetic?",
                a: "A lot of interfaces opt for utility and reusability. I did things slightly differently, fusing the Alien franchise with the dark industrial feel of EVE Online. It's not perfect, but it's cool."
            }
        ]
    },
    {
        title: "The Data",
        items: [
            {
                q: "Where does the data come from?",
                a: "zKillboard's R2Z2 feed from Squizz, which powers multiple EVE killmail tools. Socket.Kill just renders it differently. Ship fittings are rendered with <a href='https://eveship.fit' target='_blank' rel='noopener' class='text-neon-green underline'>EVEShip.fit</a>."
            },
            {
                q: "Is this open source?",
                a: "The frontend is: <a href='https://github.com/ScotDex/socketkill-v2' target='_blank' rel='noopener' class='text-neon-green underline'>github.com/ScotDex/socketkill-v2</a>. The backend stays closed for now — some corporations are sensitive."
            }
        ]
    },
    {
        title: "The Developer",
        items: [
            {
                q: "Who is responsible for this witchcraft?",
                a: "In-game name is Dexomus Viliana. You may see me hanging out on Twitch as scottishdex — come say hi :)"
            },
            {
                q: "I want to say thank you, how do I do that?",
                a: "The server is designed to run on a tiny VM, so running costs are minimal. Using a referral link in the partner slot helps, or feel free to toss some ISK at Dexomus Viliana to pay for my Loki losses."
            },
            {
                q: "Are you an idiot? Why would you make yet another killboard?",
                a: "Purely by chance. I was building an application for a different corporation and discarding a pile of lossmails, then wondered what was possible. One thing led to another and I ended up in the EVE Creator Awards."
            }
        ]
    },
    {
        id: "advertise",
        title: "Advertising",
        items: [
            {
                q: "Why are there referral links on this page?",
                a: "They pay for servers. Every link in the partner slot is either my own referral or a slot rented by another pilot, and each one is labelled. No ad networks."
            },
            {
                q: "Can I rent the partner slot for ISK?",
                a: "Yes. The slot takes a 300 × 250 image and a link, rotating with the other partners. PLACEHOLDER: price per week in ISK. Contact PLACEHOLDER (in-game mail to Dexomus Viliana / Discord)."
            },
            {
                q: "What can I advertise?",
                a: "Corporations, alliances, EVE tools and community projects. No RMT, no scams, nothing that breaks the EVE EULA. I reserve the right to refuse or pull any slot."
            }
        ]
    }
]

