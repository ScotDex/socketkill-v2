    { name: 'X', href: 'https://x.com/scottishdex', rel: 'noopener',
      d: 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z' },
]
---

<Base
    title="About — Socket.Kill"
    ogTitle="About Socket.Kill"
    ogDescription="How Socket.Kill works, where the data comes from, and how to rent the partner slot."
    hidePromo
>
    <div class="art-bg kill-screen">
        <div class="fog-overlay" aria-hidden="true"></div>

        <main class="relative max-w-6xl mx-auto px-6 py-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px] items-start">
            <h1 class="sr-only">About Socket.Kill</h1>
            <div>
                {faqSections.map(section => (
                    <section id={section.id} class="py-6 first:pt-0 scroll-mt-8">
                        <h2 class="text-neon-green font-mono text-sm tracking-[0.3em] uppercase mb-2">{section.title}</h2>
                        <div class="divide-y divide-white/10 border-y border-white/10">
                            {section.items.map(item => (
                                <details>
                                    <summary class="py-5 flex justify-between items-center gap-4 cursor-pointer list-none hover:text-neon-green transition">
                                        <span class="uppercase tracking-wide font-bold">{item.q}</span>
                                        <span class="text-neon-green text-2xl accordion-icon" aria-hidden="true"></span>
                                    </summary>
                                    <div class="pb-5 text-gray-400">
                                        <p set:html={item.a}></p>
                                    </div>
                                </details>
                            ))}
                        </div>
                    </section>
                ))}
            </div>
            <div class="flex flex-col gap-4 lg:sticky lg:top-6">
                <ReferralSlot />

                <nav aria-label="Follow Socket.Kill" class="border border-border-dim bg-glass-bg/85 font-mono">
                    <p class="px-3 py-2 border-b border-border-dim text-[0.62rem] tracking-[0.2em] uppercase text-text-faint">Follow Socket.Kill</p>
                    <ul class="grid grid-cols-4">
                        {socials.map(s => (
                            <li class="border-r border-border-dim last:border-r-0">
                                <a
                                    href={s.href}
                                    target="_blank"
                                    rel={s.rel}
                                    aria-label={`Socket.Kill on ${s.name}`}
                                    class="flex justify-center py-3 text-white/40 hover:text-neon-green hover:bg-white/[0.03] transition-colors focus-visible:outline focus-visible:outline-1 focus-visible:outline-neon-green"
                                >
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={s.d} /></svg>
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </div>
        </main>

        <footer class="relative max-w-6xl mx-auto p-4 mt-8 border-t border-white/5 text-center">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-xs tracking-widest text-gray-500 font-mono">
                <a href="/" class="hover:text-neon-green transition">&lt; BACK TO SOCKETKILL.COM</a>
                <div class="space-x-4">
                    <a href="https://github.com/ScotDex/socketkill-v2" target="_blank" rel="noopener" class="hover:text-neon-green">GITHUB</a>
                    <a href="https://discord.gg/dpgmEm9REc" target="_blank" rel="noopener" class="hover:text-neon-green">DISCORD</a>
                </div>
                <div>&copy; 2026 SOCKETKILL.COM</div>
            </div>
            <div id="legal" class="mt-6 pt-4 border-t border-white/5 text-[0.65rem] leading-relaxed text-gray-600 font-mono text-left max-w-3xl mx-auto">
                <p class="mb-2">
                    EVE Online and the EVE logo are registered trademarks of Fenris Creations. All rights are reserved worldwide.
                    All other trademarks are the property of their respective owners. FC has granted permission to socketkill.com
                    to use EVE Online and all associated logos and designs for promotional and informational purposes on its
                    website but does not endorse, and is not in any way affiliated with, socketkill.com. FC is in no way
                    responsible for the content on or functioning of this website, nor can it be liable for any damage arising
                    from the use of this website.
                </p>
                <p>
                    Background art by <a href="https://www.flickr.com/photos/rixxjavix/albums/72157651335101023" target="_blank" rel="noopener" class="text-neon-green/60 hover:text-neon-green">Rixx Javix</a>
                    and <a href="https://www.lloydgeorge.art/" target="_blank" rel="noopener" class="text-neon-green/60 hover:text-neon-green">El Geo</a>.
                    Kill data via <a href="https://github.com/zKillboard/zKillboard/wiki/API-(R2Z2)" target="_blank" rel="noopener" class="text-neon-green/60 hover:text-neon-green">zKillboard</a>.
                </p>
            </div>
        </footer>
    </div>
</Base>

<style>
    details summary::-webkit-details-marker { display: none; }
    details:not([open]) .accordion-icon::before { content: '+'; }
    details[open] .accordion-icon::before { content: '−'; }
</style>