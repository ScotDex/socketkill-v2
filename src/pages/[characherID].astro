---
import Base from '../../layouts/Base.astro'
import { externalLink } from '../../lib/entity-links.js'
import { formatIsk } from '../../lib/filter-logic.js'

const { characterID } = Astro.params
const id = parseInt(characterID)
if (!/^\d+$/.test(characterID ?? '') || !Number.isFinite(id) || id <= 0) {
    return new Response('Invalid characterID', { status: 400 })
}

// ── DATA CONTRACT (backend implements this tomorrow) ─────────────────
// GET https://ws.socketkill.com/api/pilot/{characterID}
// 200: {
//   characterID, name, corpID, corpName, allianceID, allianceName,   // identity (from ESI cache)
//   windowDays: 30,
//   events: [{
//     killID, isLoss,                     // bool — victim === this pilot
//     shipTypeID, shipName,               // victim ship on losses, THIS pilot's ship on kills if known, else victim ship
//     systemName, regionName, space,      // space: 'high'|'low'|'null'|'wh'|'pochven'
//     totalValue,                         // NUMBER (raw isk) — page formats via formatIsk
//     time,                               // ISO string
//     attackerCount
//   }]  // newest first, capped at window
// }
// 404: pilot has no events in window AND identity unknown → page falls back to ESI
// ─────────────────────────────────────────────────────────────────────

const incomingUA = Astro.request.headers.get('user-agent') || 'SocketKill-Frontend/1.0'

let pilot = null
let feedOnline = false

try {
    const res = await fetch(`https://ws.socketkill.com/api/pilot/${id}`, {
        headers: { 'User-Agent': incomingUA }
    })
    if (res.ok) {
        pilot = await res.json()
        feedOnline = true
    }
} catch { /* endpoint not live yet — fall through to ESI identity */ }

// Fallback: resolve identity from public ESI so the page works before the backend ships
if (!pilot) {
    try {
        const charRes = await fetch(`https://esi.evetech.net/latest/characters/${id}/`)
        if (!charRes.ok) return new Response('Pilot not found', { status: 404 })
        const char = await charRes.json()

        let corpName = null, allianceName = null
        if (char.corporation_id) {
            const corpRes = await fetch(`https://esi.evetech.net/latest/corporations/${char.corporation_id}/`)
            if (corpRes.ok) corpName = (await corpRes.json()).name
        }
        if (char.alliance_id) {
            const allRes = await fetch(`https://esi.evetech.net/latest/alliances/${char.alliance_id}/`)
            if (allRes.ok) allianceName = (await allRes.json()).name
        }

        pilot = {
            characterID: id,
            name: char.name,
            corpID: char.corporation_id ?? null,
            corpName,
            allianceID: char.alliance_id ?? null,
            allianceName,
            windowDays: 30,
            events: []
        }
    } catch {
        return new Response('Pilot lookup failed', { status: 502 })
    }
}

Astro.response.headers.set('Cache-Control', 'public, max-age=60')

const events = pilot.events ?? []
const kills = events.filter(e => !e.isLoss)
const losses = events.filter(e => e.isLoss)

function relativeTime(iso) {
    const diff = Date.now() - new Date(iso).getTime()
    const m = Math.floor(diff / 60000)
    if (m < 1) return 'JUST NOW'
    if (m < 60) return `${m}M AGO`
    const h = Math.floor(m / 60)
    if (h < 24) return `${h}H AGO`
    return `${Math.floor(h / 24)}D AGO`
}

const SPACE_CHIP = {
    high:    { label: 'HS',   color: 'var(--color-neon-green)' },
    low:     { label: 'LS',   color: 'var(--color-whale-accent)' },
    null:    { label: 'NULL', color: 'var(--color-isk-billion)' },
    wh:      { label: 'WH',   color: 'var(--color-terminal-blue)' },
    pochven: { label: 'PCH',  color: '#b07ce8' },
}

function valueColor(v) {
    if (v >= 10_000_000_000) return 'var(--color-whale-accent)'
    if (v >= 1_000_000_000) return 'var(--color-isk-billion)'
    return 'var(--color-neon-green)'
}

const title = `${pilot.name} — Pilot Activity`
---

<Base title={`${title} | Socketkill.com`} ogTitle={title}
    ogDescription={`Recent kills and losses for ${pilot.name} — last ${pilot.windowDays} days, live from SocketKill.`}>
    <div class="kill-screen">
        <main class="relative z-10 max-w-4xl mx-auto px-4 py-8">

            <!-- IDENTITY -->
            <header class="fade-card flex items-center gap-4 border-b border-[var(--color-border-dim)] pb-5 mb-6">
                <img
                    src={`https://images.evetech.net/characters/${pilot.characterID}/portrait?size=128`}
                    alt={pilot.name}
                    class="w-20 h-20 border border-[var(--color-border-mid)]"
                    loading="eager"
                />
                <div class="min-w-0 flex-1">
                    <h1 class="kill-headline truncate">{pilot.name}</h1>
                    <p class="kill-sub truncate">
                        {pilot.corpID
                            ? <a href={externalLink('corp', pilot.corpID)} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-neon-green)] transition-colors">{pilot.corpName ?? '—'}</a>
                            : (pilot.corpName ?? '—')}
                        {pilot.allianceName && <span> // {pilot.allianceID
                            ? <a href={externalLink('alliance', pilot.allianceID)} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-neon-green)] transition-colors">{pilot.allianceName}</a>
                            : pilot.allianceName}</span>}
                    </p>
                </div>
                <div class="flex gap-2 shrink-0">
                    {pilot.corpID && <img src={`https://images.evetech.net/corporations/${pilot.corpID}/logo?size=64`} alt="" class="w-10 h-10" loading="lazy" />}
                    {pilot.allianceID && <img src={`https://images.evetech.net/alliances/${pilot.allianceID}/logo?size=64`} alt="" class="w-10 h-10" loading="lazy" />}
                </div>
            </header>

            <!-- WINDOW BANNER — the radar-not-ledger declaration, always visible -->
            <div class="fade-card flex items-center justify-between mb-5 font-mono text-[11px] tracking-[0.2em] uppercase">
                <span class="text-[var(--color-neon-green)]" style="text-shadow: var(--shadow-phosphor)">&gt; RECENT ACTIVITY // LAST {pilot.windowDays} DAYS</span>
                <span class="text-[var(--color-text-faint)] tabular-nums">
                    <span class="text-[var(--color-neon-green)]">{kills.length} KILLS</span>
                    <span class="mx-1 text-white/20">/</span>
                    <span class="text-[var(--color-isk-billion)]">{losses.length} LOSSES</span>
                </span>
            </div>

            <!-- FEED -->
            {!feedOnline ? (
                <div class="fade-card flex flex-col items-center justify-center min-h-[240px] border border-dashed border-[var(--color-eve-border)] bg-[var(--color-eve-dark)]/30">
                    <span class="font-mono text-sm tracking-[0.18em] uppercase text-[var(--color-terminal-blue)] animate-pulse">&gt; ACTIVITY UPLINK OFFLINE</span>
                    <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-[var(--color-text-faint)] mt-2">pilot record found — activity feed coming online soon</span>
                </div>
            ) : events.length === 0 ? (
                <div class="fade-card flex flex-col items-center justify-center min-h-[240px] border border-dashed border-[var(--color-eve-border)] bg-[var(--color-eve-dark)]/30">
                    <span class="font-mono text-sm tracking-[0.18em] uppercase text-[var(--color-text-faint)]">&gt; NO ACTIVITY IN THE LAST {pilot.windowDays} DAYS &lt;</span>
                    <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-[var(--color-text-faint)]/60 mt-2">quiet skies — or flying safe</span>
                </div>
            ) : (
                <ul class="fade-card border border-[var(--color-border-dim)] bg-[var(--color-feed-bg)]/40 divide-y divide-[var(--color-border-dim)]/50">
                    {events.map(e => {
                        const chip = SPACE_CHIP[e.space] ?? { label: '?', color: 'var(--color-text-faint)' }
                        return (
                        <li>
                            <a href={`/kill/${e.killID}`}
                               class="flex items-center gap-3 px-3 py-2.5 border-l-[3px] hover:bg-white/[0.03] transition-colors"
                               style={`border-left-color: ${e.isLoss ? 'var(--color-isk-billion)' : 'var(--color-neon-green)'}`}>
                                <img src={`https://images.evetech.net/types/${e.shipTypeID}/render?size=64`}
                                     alt="" class="w-10 h-10 shrink-0" loading="lazy" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-baseline gap-2">
                                        <span class="font-mono text-[10px] tracking-[0.16em] uppercase shrink-0"
                                              style={`color: ${e.isLoss ? 'var(--color-isk-billion)' : 'var(--color-neon-green)'}`}>
                                            {e.isLoss ? 'LOSS' : 'KILL'}
                                        </span>
                                        <span class="ship-name text-sm font-semibold text-[var(--color-text-body)] truncate">{e.shipName}</span>
                                    </div>
                                    <div class="font-mono text-[11px] text-[var(--color-text-faint)] truncate">
                                        <span class="chip" style={`--c:${chip.color}; color:${chip.color}`}>{chip.label}</span>
                                        <span class="ml-1.5">{e.systemName}</span>
                                        <span class="text-white/25 mx-1">·</span>
                                        <span>{e.regionName}</span>
                                    </div>
                                </div>
                                <div class="text-right shrink-0">
                                    <div class="font-mono text-sm font-bold tabular-nums" style={`color: ${valueColor(e.totalValue)}`}>{formatIsk(e.totalValue)}</div>
                                    <div class="font-mono text-[10px] tracking-[0.14em] text-[var(--color-text-faint)] tabular-nums">
                                        {e.attackerCount > 1 ? `${e.attackerCount} INV` : 'SOLO'}
                                        <span class="text-white/25 mx-1">·</span>
                                        {relativeTime(e.time)}
                                    </div>
                                </div>
                            </a>
                        </li>
                        )
                    })}
                </ul>
            )}

            <!-- RADAR DISCLAIMER -->
            <p class="fade-card mt-4 font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-text-faint)]/50 text-center">
                socketkill is a radar, not a record — activity older than {pilot.windowDays} days is not retained
            </p>

            <!-- FOOTER -->
            <footer class="mt-8 border-t border-[var(--color-eve-border)] pt-4 text-center">
                <div class="font-mono text-[11px] tracking-[0.14em] text-[var(--color-text-faint)] space-x-4">
                    <a href="/" class="hover:text-[var(--color-neon-green)] transition-colors">&lt; BACK TO SOCKETKILL.COM</a>
                    <a href={externalLink('character', pilot.characterID)} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-neon-green)] transition-colors">FULL HISTORY ON ZKILLBOARD</a>
                </div>
            </footer>

        </main>
    </div>
</Base>