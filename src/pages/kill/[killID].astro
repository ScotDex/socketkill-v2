---
import Base from '../../layouts/Base.astro'
import { externalLink } from '../../lib/entity-links.js'
import AttackerRow from '../../components/astro/AttackerRow.astro'
import './style.css'
const { killID } = Astro.params
const id = parseInt(killID)
if (!Number.isFinite(id) || id <= 0) {
    return new Response('Invalid killID', { status: 400 })
}

const incomingUA = Astro.request.headers.get('user-agent') || 'SocketKill-Frontend/1.0'

let kill = null

try {
    const res = await fetch(`https://ws.socketkill.com/api/kill/${id}`, {
        headers: { 'User-Agent': incomingUA }
    })
    if (!res.ok) {
        if (res.status === 503) {
            return new Response('Killmail warming up, retry shortly', {
                status: 503,
                headers: { 'Retry-After': '300' }
            })
        }
        return new Response('Kill not found', { status: 404 })
    }
    kill = await res.json()
} catch (err) {
    return new Response(`Error: ${err.message}`, { status: 500 })
}

const isToday = (kill.killmailTime ?? '').slice(0, 10) === new Date().toISOString().slice(0, 10);
Astro.response.headers.set(
    'Cache-Control',
    isToday ? 'public, max-age=60' : 'public, max-age=31536000, immutable'
);

function article(shipName) {
    if (!shipName) return 'a'
    const vowels = ['a', 'e', 'i', 'o', 'u']
    return vowels.includes(shipName[0].toLowerCase()) ? 'an' : 'a'
}

function buildTitle(data) {
    const valueClause = data.totalValue ? ` (${data.totalValue} ISK)` : ''
    return `${data.victim.name} lost ${article(data.victim.ship)} ${data.victim.ship}${valueClause}`
}

const EFT_FITTED = ['low', 'mid', 'high', 'rig', 'subsystem']
const EFT_LOOSE  = ['drone', 'fighter', 'cargo']

function buildEft(kill) {
    const g = kill.items?.groups || {}
    const ship = kill.victim?.ship || 'Unknown Ship'
    const clean = it => it.name && it.name !== 'Unknown'   // skip unimportable lines
    const lines = [`[${ship}, ${ship} - ${kill.killID ?? 'loss'}]`, '']

    for (const slot of EFT_FITTED)
        for (const it of (g[slot] || []).filter(clean))
            for (let n = 0; n < (it.quantity || 1); n++) lines.push(it.name)

    const loose = []
    for (const slot of EFT_LOOSE)
        for (const it of (g[slot] || []).filter(clean))
            loose.push(it.quantity > 1 ? `${it.name} x${it.quantity}` : it.name)
    if (loose.length) lines.push('', ...loose)

    return lines.join('\n')
}
const eftText = buildEft(kill)

function buildDescription(data) {
    const victimAffiliation = data.victim.corp || data.victim.alliance
    const victimLabel = victimAffiliation ? `${data.victim.name} of ${victimAffiliation}` : data.victim.name
    let main = `${victimLabel} lost ${article(data.victim.ship)} ${data.victim.ship} in ${data.system.name} | ${data.system.region}`
    if (data.totalValue) main += ` worth ${data.totalValue} ISK`

    if (data.finalBlow) {
        const fbAffiliation = data.finalBlow.corp || data.finalBlow.alliance
        const fbLabel = fbAffiliation ? `${data.finalBlow.name} of ${fbAffiliation}` : data.finalBlow.name
        let fb = `Final blow by ${fbLabel} in ${article(data.finalBlow.ship)} ${data.finalBlow.ship}`
        if (data.attackerCount > 1) fb += ` with ${data.attackerCount} attackers`
        return `${main}: ${fb}`
    }
    return main
}

const title = buildTitle(kill)
const description = buildDescription(kill)

const shipTypeID = kill.victim?.shipTypeID ?? null
const image = shipTypeID
    ? `https://images.evetech.net/types/${shipTypeID}/render?size=512`
    : 'https://edge.socketkill.com/socket-preview-v2.png'
const canonicalUrl = `https://socketkill.com/kill/${id}`

const fitPreviewUrl = kill.killmailHash
    ? `https://eveship.fit/preview?fit=killmail:${id}/${kill.killmailHash}`
    : null
const fitEditorUrl = kill.killmailHash
    ? `https://eveship.fit/?fit=killmail:${id}/${kill.killmailHash}`
    : null

const bgStyle = shipTypeID
    ? `background-image: linear-gradient(rgba(10,12,16,0.85), rgba(10,12,16,0.95)), url(https://api.socketkill.com/kills); background-size: cover; background-position: center; background-attachment: fixed;`
    : ''

const killTime = kill.killmailTime ? new Date(kill.killmailTime).toUTCString() : '—'

function classifySecurity(system) {
    if (!system || system.security == null) return { label: 'UNKNOWN', color: 'var(--color-text-faint)' }
    if (system.id >= 31000000 && system.id < 32000000) return { label: 'WORMHOLE', color: 'var(--color-terminal-blue)' }
    if (system.regionID === 10000070 || system.region === 'Pochven') return { label: 'POCHVEN', color: '#b07ce8' }
    const s = system.security
    if (s >= 0.5) return { label: `HIGHSEC ${s.toFixed(1)}`, color: 'var(--color-neon-green)' }
    if (s > 0.0)  return { label: `LOWSEC ${s.toFixed(1)}`, color: 'var(--color-whale-accent)' }
    return { label: `NULLSEC ${s.toFixed(1)}`, color: 'var(--color-isk-billion)' }
}
const sec = classifySecurity(kill.system)

function parseIsk(v) {
    if (typeof v === 'number') return v
    if (typeof v !== 'string') return 0
    const m = v.match(/([\d.,]+)\s*([KMBT])?/i)
    if (!m) return 0
    const n = parseFloat(m[1].replace(/,/g, ''))
    const mult = { K: 1e3, M: 1e6, B: 1e9, T: 1e12 }[m[2]?.toUpperCase()] ?? 1
    return n * mult
}
const totalIsk = parseIsk(kill.totalValue)
const valueTier =
    totalIsk >= 10_000_000_000 ? 'var(--color-whale-accent)'
    : totalIsk >= 1_000_000_000 ? 'var(--color-isk-billion)'
    : 'var(--color-neon-green)'

const droppedIsk = parseIsk(kill.droppedValue)
const destroyedIsk = parseIsk(kill.destroyedValue)
const splitTotal = droppedIsk + destroyedIsk
const droppedPct = splitTotal > 0 ? (droppedIsk / splitTotal * 100).toFixed(1) : 0
const GROUP_LABELS = {
    high: 'HIGH SLOTS', mid: 'MID SLOTS', low: 'LOW SLOTS', rig: 'RIGS',
    subsystem: 'SUBSYSTEMS', drone: 'DRONE BAY', fighter: 'FIGHTER BAY',
    cargo: 'CARGO HOLD', implant: 'IMPLANTS', other: 'OTHER'
}
const GROUP_ORDER = ['high', 'mid', 'low', 'rig', 'subsystem', 'drone', 'fighter', 'cargo', 'implant', 'other']
const groups = kill.items?.groups || {}
const orderedGroups = GROUP_ORDER.filter(g => groups[g]?.length).map(g => ({ key: g, label: GROUP_LABELS[g], items: groups[g] }))
const attackers = kill.attackers || []
const sortedAttackers = [...attackers].sort((a, b) => {
    if (a.finalBlow === b.finalBlow) return 0
    return a.finalBlow ? -1 : 1
})
const visibleAttackers = sortedAttackers.slice(0, 5)
const hiddenAttackers = sortedAttackers.slice(5)
---

<Base
    title={`${title} | Socketkill.com`}
    ogTitle={title}
    ogDescription={description}
    ogImage={image}
    ogImageWidth="512"
    ogImageHeight="512"
    ogUrl={canonicalUrl}
    ogType="article"
    twitterCard="summary"
>
    <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description: description,
        image: [image],
        datePublished: kill.killmailTime,
        url: canonicalUrl,
        publisher: { "@type": "Organization", name: "Socket.Kill", url: "https://socketkill.com" },
        author: { "@type": "Organization", name: "Socket.Kill" }
    })}></script>
</Fragment>

    <div class="kill-screen" style={bgStyle}>
    <header class="max-w-7xl mx-auto px-4 pt-6 relative z-10">
        <h1 class="kill-headline">{title}</h1>
        <p class="kill-sub">{kill.system.name} | {kill.system.region} -  {killTime}</p>
        </header>
        <main class="grid grid-cols-1 md:grid-cols-[360px_1fr] gap-4 p-4 max-w-7xl mx-auto relative z-10">

            <!-- SIDEBAR -->
            <section class="flex flex-col gap-4">

                <!-- VICTIM DOSSIER -->
                <div class="card" style={`--card-c: ${valueTier}; --d: 0ms`}>
                    <header class="card-h flex justify-between items-center">
                        <span>victim dossier</span>
                        <span class="tag">LOSS RECORDED</span>
                    </header>

                    {shipTypeID && (
                        <div class="cover">
                            <img src={image} alt={kill.victim.ship} loading="lazy" />
                        </div>
                    )}

                    <div class="ident">
                        {kill.victim.characterID && (
                            <img class="portrait-sm" src={`https://images.evetech.net/characters/${kill.victim.characterID}/portrait?size=128`} alt={kill.victim.name} loading="lazy" />
                        )}
                        <div class="who">
                            <div class="nm">
                                {kill.victim.characterID
                                    ? <a href={externalLink('character', kill.victim.characterID)} target="_blank" rel="noopener noreferrer" class="link">{kill.victim.name}</a>
                                    : kill.victim.name}
                            </div>
                            <div class="af">
                                {kill.victim.corporationID
                                    ? <a href={externalLink('corp', kill.victim.corporationID)} target="_blank" rel="noopener noreferrer" class="link">{kill.victim.corp}</a>
                                    : kill.victim.corp}
                            </div>
                            <div class="af">
                                {kill.victim.allianceID
                                    ? <a href={externalLink('alliance', kill.victim.allianceID)} target="_blank" rel="noopener noreferrer" class="link">{kill.victim.alliance}</a>
                                    : (kill.victim.alliance || 'Non Affiliate')}
                            </div>
                        </div>
                        <div class="dossier-badges">
                            {kill.victim.corporationID && (
                                <img src={`https://images.evetech.net/corporations/${kill.victim.corporationID}/logo?size=64`} alt="" loading="lazy" />
                            )}
                            {kill.victim.allianceID && (
                                <img src={`https://images.evetech.net/alliances/${kill.victim.allianceID}/logo?size=64`} alt="" loading="lazy" />
                            )}
                        </div>
                    </div>

                    <div class="dossier-rows">
                        <div class="row"><span class="k">SHIP</span><span class="v">{kill.victim.ship}</span></div>
                        <div class="row"><span class="k">SYSTEM</span>
                            <a href={externalLink('system', kill.system.name)} target="_blank" rel="noopener noreferrer" class="v link truncate">{kill.system.name}</a></div>
                        <div class="row"><span class="k">REGION</span>
                            <a href={externalLink('region', kill.system.region)} target="_blank" rel="noopener noreferrer" class="v link truncate">{kill.system.region}</a></div>
                        <div class="row"><span class="k">SEC.STATUS</span>
                            <span class="chip" style={`--c:${sec.color}`}>{sec.label}</span></div>
                        <div class="row"><span class="k">TIME</span><span class="v text-xs">{killTime}</span></div>
                        {kill.victim.damageTaken != null && (
                            <div class="row"><span class="k">DAMAGE TAKEN</span>
                                <span class="v" style="color: var(--color-isk-billion)">{kill.victim.damageTaken.toLocaleString()}</span></div>
                        )}
                        <div class="row"><span class="k">ATTACKERS</span><span class="v">{kill.attackerCount}</span></div>
                        <div class="row" id="sys-activity" data-id={kill.system?.id ?? ''} hidden>
                            <span class="k">SYSTEM STATS</span>
                            <span class="v" data-count></span></div>
                        <div class="row" id="reg-activity" data-id={kill.system?.regionID ?? ''} hidden>
                            <span class="k">REGION STATS</span>
                            <span class="v" data-count></span></div>

                        <div class="row mt-2"><span class="k">TOTAL VALUE</span>
                            <span class="v" style={`color:${valueTier}; text-shadow: 0 0 8px color-mix(in srgb, ${valueTier} 40%, transparent)`}>{kill.totalValue ?? '—'}</span></div>
                        <div class="row"><span class="k">DROPPED</span>
                            <span class="v" style="color: var(--color-neon-green)">{kill.droppedValue ?? '—'}</span></div>
                        <div class="row"><span class="k">DESTROYED</span>
                            <span class="v" style="color: var(--color-isk-billion)">{kill.destroyedValue ?? '—'}</span></div>
                        <div class="row"><span class="k">FITTING</span><span class="v">{kill.fittedValue ?? '—'}</span></div>
                        {splitTotal > 0 && (
                            <div class="split-bar" title={`${droppedPct}% dropped`}>
                                <span style={`width:${droppedPct}%`}></span>
                            </div>
                        )}
                    </div>

                    <div class="dossier-actions">
                        {fitPreviewUrl ? (
                            <button type="button" id="fit-btn"
                                data-fit-url={fitPreviewUrl}
                                data-editor-url={fitEditorUrl}
                                class="act act-primary">VIEW FIT</button>
                        ) : (
                            <span class="act" style="opacity:0.4; cursor:default">VIEW FIT</span>
                        )}
                        <button type="button" id="eft-btn" data-eft={eftText} class="act">EFT EXPORT</button>
                        <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener noreferrer" class="act act-primary">SHARE ON X</a>
                    </div>

                    <footer class="card-f" style="color: var(--color-isk-billion)"><span class="pulse-dot"></span> status: dead</footer>
                </div>

                <!-- ATTACKERS -->
                <div class="card" style="--card-c: var(--color-isk-billion); --d: 60ms">
                    <header class="card-h flex justify-between items-center">
                        <span>attackers</span>
                        <span class="font-mono text-sm tabular-nums" style="color: var(--color-isk-billion)">{kill.attackerCount}</span>
                    </header>
                    <ul class="p-3 space-y-2">
    {visibleAttackers.map(a => <AttackerRow a={a} />)}
</ul>
                    {hiddenAttackers.length > 0 && (
                        <details class="px-3 pb-3">
                            <summary class="more">SHOW {hiddenAttackers.length} MORE</summary>
                            <ul class="space-y-2 mt-2">
    {hiddenAttackers.map(a => <AttackerRow a={a} />)}
</ul>
                        </details>
                    )}
                </div>
            </section>

            <!-- MAIN: MANIFEST -->
            <section class="card self-start" style="--card-c: var(--color-neon-green); --d: 45ms">
                <header class="card-h flex justify-between items-center">
                    <span> details</span>
                    <div class="tabs" id="loot-tabs" role="tablist">
                        <button type="button" class="tab is-active" data-mode="all" role="tab" aria-selected="true">ALL</button>
                        <button type="button" class="tab" data-mode="dropped" role="tab" aria-selected="false">DROPPED</button>
                        <button type="button" class="tab" data-mode="destroyed" role="tab" aria-selected="false">DESTROYED</button>
                    </div>
                </header>

                {orderedGroups.length === 0 ? (
                    <div class="ui p-4 text-sm text-[var(--color-text-faint)] italic">&gt; NO ITEMS</div>
                ) : (
                    <div id="manifest" class="p-4 space-y-5">
                        {orderedGroups.map(group => {
                            const totalDropped = group.items.reduce((sum, i) => sum + (i.dropped || 0), 0)
                            const totalDestroyed = group.items.reduce((sum, i) => sum + (i.destroyed || 0), 0)
                            return (
                                <div class="item-group" data-group>
                                    <div class="flex justify-between items-baseline border-b border-[color-mix(in_srgb,var(--color-neon-green)_18%,transparent)] pb-1 mb-2">
                                        <span class="grp">{group.label}</span>
                                        <span class="font-mono text-[10px] tabular-nums text-[var(--color-text-faint)]">
                                            <span style="color: var(--color-neon-green)">{totalDropped}D</span> / <span style="color: var(--color-isk-billion)">{totalDestroyed}X</span>
                                        </span>
                                    </div>
                                    <ul class="space-y-1">
                                        {group.items.map(item => {
    const accent = item.dropped > 0 && item.destroyed > 0 ? 'var(--color-whale-accent)'
        : item.dropped > 0 ? 'var(--color-neon-green)'
        : 'var(--color-isk-billion)'
    return (
    <li class="flex items-center gap-2 text-sm hover:bg-white/[0.03] transition-colors pl-2 pr-1 -mx-1 border-l-2" style={`border-color: ${accent}`} data-row data-dropped={item.dropped > 0 ? '1' : undefined} data-destroyed={item.destroyed > 0 ? '1' : undefined}>
                                                <img
    src={`https://images.evetech.net/types/${item.typeID}/icon?size=32`}
    data-bp={`https://images.evetech.net/types/${item.typeID}/bp?size=32`}
    onerror="if(!this.dataset.fb){this.dataset.fb=1;this.src=this.dataset.bp}"
    class="w-6 h-6 flex-shrink-0" alt="" loading="lazy" />
                                                <div class="ui flex-1 min-w-0 truncate">
                                                    <a href={externalLink('type', item.typeID)} target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-body)] link">{item.name}</a>
                                                </div>
                                                <div class="font-mono text-xs tabular-nums flex-shrink-0">
                                                    {item.dropped > 0 && <span style="color: var(--color-neon-green)">+{item.dropped}</span>}
                                                    {item.dropped > 0 && item.destroyed > 0 && <span class="mx-1 text-white/20">/</span>}
                                                    {item.destroyed > 0 && <span style="color: var(--color-isk-billion)">−{item.destroyed}</span>}
                                                </div>
                                                <div class="font-mono text-xs tabular-nums text-[var(--color-text-faint)] w-20 text-right flex-shrink-0">{item.formattedValue}</div>
                                            </li>
                                        )})}
                                    </ul>
                                </div>
                            )
                        })}
                        <div id="manifest-empty" class="ui text-sm text-[var(--color-text-faint)] italic" hidden>&gt; NO MATCHING ITEMS</div>
                    </div>
                )}

                <footer class="card-f" style="color: var(--color-text-faint)">
                    &gt; cross-ref:
                    <a href={`https://zkillboard.com/kill/${id}/`} target="_blank" rel="noopener noreferrer" class="link">ZKILLBOARD</a>
                    ·
                    <a href={`https://eve-kill.com/kill/${id}/`} target="_blank" rel="noopener noreferrer" class="link">EVE-KILL</a>
                </footer>
            </section>
        </main>

        <footer class="relative z-10 max-w-7xl mx-auto p-4 mt-8 border-t border-[var(--color-eve-border)] text-center">
            <div class="ui flex flex-col md:flex-row justify-between items-center gap-4 text-[11px] tracking-[0.14em] text-[var(--color-text-faint)]">
                <div>
                    <a href="/" class="link">&lt; BACK TO SOCKETKILL.COM</a>
                </div>
                <div class="space-x-4">
                    <a href="/about" class="link">ABOUT</a>
                    <a href="https://github.com/ScotDex/socketkill-v2" target="_blank" rel="noopener" class="link">GITHUB</a>
                    <a href="https://api.socketkill.com/docs/" class="link">API</a>
                    <a href="https://discord.gg/dpgmEm9REc" target="_blank" rel="noopener" class="link">DISCORD</a>
                </div>
                <div>&copy; SOCKETKILL.COM</div>
            </div>
        </footer>
    </div>

    {fitPreviewUrl && (
        <dialog id="fit-modal" class="fit-modal">
            <header class="card-h flex justify-between items-center" style="--card-c: var(--color-terminal-blue)">
                <span>fit analysis</span>
                <div class="flex items-center gap-3">
                    <a href={fitEditorUrl} target="_blank" rel="noopener noreferrer" class="tag link">OPEN IN EDITOR</a>
                    <button type="button" id="fit-close" class="tag link" aria-label="Close fit preview">[X]</button>
                </div>
            </header>
            <iframe
                id="fit-frame"
                title={`Fit preview: ${kill.victim.ship}`}
                data-src={fitPreviewUrl}
            ></iframe>
            <footer class="card-f" style="color: var(--color-terminal-blue)">&gt; simulated via eveship.fit — all skills v</footer>
        </dialog>
    )}
</Base>

<script src="./_script.js"></script>