---
import Base from '../layouts/Base.astro'
import SiteHeader from '../components/svelte/SiteHeader.svelte'
import LiveFeed from '../components/svelte/LiveFeed.svelte'
---

<Base
    title="Live EVE Online Killmail Feed | Socketkill.com"
    ogTitle="Socket.Kill"
    ogDescription="Real-time EVE Online killmails, pushed the moment they land. Watch New Eden's losses stream live, filtered by system, ship, corporation or alliance."
>
    <div class="crt-screen max-w-[1700px] mx-auto px-4 py-3">
        <SiteHeader client:load />
        <main class="mt-4">
            <LiveFeed client:only="svelte" />
        </main>
    </div>
</Base>