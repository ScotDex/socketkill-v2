---
// src/pages/search.astro
import Base from '../layouts/Base.astro'
import SearchResults from '../components/svelte/SearchResults.svelte'
---

<Base
  title="Search killmails"
  ogTitle="Socket.Kill Search Engine"
  ogDescription="Review all killmails from 0001 UTC onwards, configure your own filter to view whatever kills you have in mind"
  ogUrl="https://socketkill.com/search"
>
<main class="art-bg min-h-screen">
  <div class="search-page">
    <SearchResults client:load />
  </div>
</main>
<style>
  .search-page { max-width: 1200px; margin: 0 auto; padding: 1rem; }
</style>