---
// src/pages/search.astro
import Base from '../layouts/Base.astro'
import SearchResults from '../components/svelte/SearchResults.svelte'
---

<Base
  title="Analytics | Socket.Kill"
  ogTitle="EVE Online Analytics — Socket.Kill"
  ogDescription="Configure a filter to view whatever kills you want for the day, how many shuttles have been smartbombed in blackrise today? Lets find out."
  ogUrl="https://socketkill.com/search"
>
  <main class="search-page">
    <SearchResults client:load />
  </main>
</Base>

<style>
  .search-page { max-width: 1200px; margin: 0 auto; padding: 1rem; }
</style>