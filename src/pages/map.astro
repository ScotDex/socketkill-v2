---
import Base from '../layouts/Base.astro'
import GalaxyMap from '../components/svelte/GalaxyMap.svelte'
---
<Base
    title="Live Map | Socketkill.com"
    ogTitle="Socket.Kill Live Map"
    ogDescription="Live EVE Online kills on a 3D map of New Eden."
>
    <Fragment slot="head">
        <link rel="preconnect" href="https://eo-map.com" crossorigin />
        <link rel="preconnect" href="https://snapshots.eo-map.com" crossorigin />
        <link rel="modulepreload" href="https://eo-map.com/embed/v1.js" />
    </Fragment>
    <main>
        <GalaxyMap client:only="svelte" />
    </main>
</Base>